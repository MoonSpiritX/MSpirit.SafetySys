<UserControl x:Class="MS_SafetyManagementSystem.Peoplemanagement.PersonnelRecordCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:MS_SafetyManagementSystem.Controls"
             mc:Ignorable="d" 
             Height="Auto" MinWidth="860"
             HorizontalAlignment="Left"  
             Background="transparent"
             x:Name="RootControl"
             PreviewMouseDown="RootControl_PreviewMouseDown"
             PreviewKeyDown="RootControl_PreviewKeyDown">

    <UserControl.Resources>
        <!-- 样式保持不变（省略，与原来一致） -->
        <Style x:Key="SquareRoundCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Width="18" Height="18" CornerRadius="4" Background="Transparent"
                                BorderBrush="#CCFFFFFF" BorderThickness="1">
                            <Border x:Name="checkMark" Background="Transparent" CornerRadius="3" Margin="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Background" Value="#14B09B"/>
                                <Setter Property="BorderBrush" Value="#14B09B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="10pt"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 文本框默认样式：无焦点视觉指示器，透明背景，禁用右键菜单 -->
        <Style TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu Visibility="Collapsed" Width="0" Height="0"/>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="TextBox_PreviewMouseRightButtonDown"/>
            <EventSetter Event="PreviewMouseRightButtonUp" Handler="TextBox_PreviewMouseRightButtonUp"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Margin="2,0,3,2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="10pt"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#CCFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#17c3b2"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0f8f82"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Switch 样式（是/否滑块） -->
        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="14" Background="#CCCCCC" BorderThickness="0">
                            <Grid>
                                <TextBlock x:Name="YesText" Text="是" 
                                           HorizontalAlignment="Left" Margin="10,0,0,0"
                                           VerticalAlignment="Center" FontSize="10pt" Foreground="#999"/>
                                <TextBlock x:Name="NoText" Text="否" 
                                           HorizontalAlignment="Right" Margin="0,0,10,0"
                                           VerticalAlignment="Center" FontSize="10pt" Foreground="White"/>
                                <Border x:Name="Thumb" Width="24" Height="24" 
                                        CornerRadius="12" Background="White"
                                        HorizontalAlignment="Left" Margin="2"
                                        BorderThickness="0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.2" Color="Black"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#17c3b2"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="YesText" Property="Foreground" Value="White"/>
                                <Setter TargetName="NoText" Property="Foreground" Value="#999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="CardBorder" BorderBrush="#19528BD6" BorderThickness="2" Padding="4" CornerRadius="5" Margin="2"
                Background="Transparent"
                PreviewMouseRightButtonDown="CardBorder_PreviewMouseRightButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.1" Color="Black"/>
            </Border.Effect>

            <Grid x:Name="ContentGrid" Focusable="True" FocusVisualStyle="{x:Null}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <!-- 文本栏 -->
                    <ColumnDefinition Width="*" MinWidth="260" />
                    <!-- 身份证栏 -->
                    <ColumnDefinition Width="*" MinWidth="260" />
                    <!-- 证书栏 -->
                </Grid.ColumnDefinitions>

                <!-- ==================== 第一栏：文本信息 ==================== -->
                <Grid Grid.Column="0" Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 行0：序号 + CheckBox -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="序号：" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DisplayIndex}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="20,0,0,0" Style="{StaticResource SquareRoundCheckBoxStyle}" Focusable="False"/>
                    </StackPanel>

                    <!-- 行1：姓名 | 性别 | 岗位（三列均分） -->
                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="姓名" FontSize="10pt" Foreground="#666" Margin="0,0,0,2"/>
                            <TextBox x:Name="NameTextBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Height="30" FontSize="10pt" VerticalContentAlignment="Center" Padding="6,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,4,0">
                            <TextBlock Text="性别" FontSize="10pt" Foreground="#666" Margin="0,0,0,2"/>
                            <TextBox x:Name="GenderTextBox" Text="{Binding Gender, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="True" PreviewMouseLeftButtonDown="GenderTextBox_PreviewMouseLeftButtonDown"
                                     Height="30" FontSize="10pt" VerticalContentAlignment="Center" Padding="6,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                            <TextBlock Text="岗位" FontSize="10pt" Foreground="#666" Margin="0,0,0,2"/>
                            <TextBox x:Name="PositionTextBox" Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}" Height="30" FontSize="10pt" VerticalContentAlignment="Center" Padding="6,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 行2：出生年月 | 年龄 | 工号（三列均分） -->
                    <Grid Grid.Row="2" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="出生年月" FontSize="10pt" Foreground="#666" Margin="0,0,0,2"/>
                            <TextBox x:Name="BirthDateTextBox" Text="{Binding BirthDate, UpdateSourceTrigger=PropertyChanged}" Height="30" FontSize="10pt" VerticalContentAlignment="Center" Padding="6,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,4,0">
                            <TextBlock Text="年龄" FontSize="10pt" Foreground="#666" Margin="0,0,0,2"/>
                            <TextBox x:Name="AgeTextBox" Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}" Height="30" FontSize="10pt" VerticalContentAlignment="Center" Padding="6,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                            <TextBlock Text="工号" FontSize="10pt" Foreground="#666" Margin="0,0,0,2"/>
                            <TextBox x:Name="EmployeeIDTextBox" Text="{Binding EmployeeID, UpdateSourceTrigger=PropertyChanged}" Height="30" FontSize="10pt" VerticalContentAlignment="Center" Padding="6,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 行3：籍贯 | 文化程度 | 手机号（三列均分） -->
                    <Grid Grid.Row="3" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="籍贯" FontSize="10pt" Foreground="#666" Margin="0,0,0,2"/>
                            <TextBox x:Name="NativePlaceTextBox" Text="{Binding NativePlace, UpdateSourceTrigger=PropertyChanged}" Height="30" FontSize="10pt" VerticalContentAlignment="Center" Padding="6,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,4,0">
                            <TextBlock Text="文化程度" FontSize="10pt" Foreground="#666" Margin="0,0,0,2"/>
                            <TextBox x:Name="EducationLevelTextBox" Text="{Binding EducationLevel, UpdateSourceTrigger=PropertyChanged}" Height="30" FontSize="10pt" VerticalContentAlignment="Center" Padding="6,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                            <TextBlock Text="手机号" FontSize="10pt" Foreground="#666" Margin="0,0,0,2"/>
                            <TextBox x:Name="PhoneNumberTextBox" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Height="30" FontSize="10pt" VerticalContentAlignment="Center" Padding="2,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 行4：入场时间 | 教育时间 | 退场时间（三列均分） -->
                    <Grid Grid.Row="4" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="入场时间" FontSize="10pt" Foreground="#2B6CB0" Margin="0,0,0,2"/>
                            <TextBox x:Name="EntryTimeTextBox" Text="{Binding EntryTime, UpdateSourceTrigger=PropertyChanged}" Height="30" FontSize="10pt" VerticalContentAlignment="Center" Padding="6,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,4,0">
                            <TextBlock Text="教育时间" FontSize="10pt" Foreground="#2B6CB0" Margin="0,0,0,2"/>
                            <TextBox x:Name="EduTimeTextBox" Text="{Binding EduTime, UpdateSourceTrigger=PropertyChanged}" Height="30" FontSize="10pt" VerticalContentAlignment="Center" Padding="6,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                            <TextBlock Text="退场时间" FontSize="10pt" Foreground="#2B6CB0" Margin="0,0,0,2"/>
                            <TextBox x:Name="ExitTimeTextBox" Text="{Binding ExitTime, UpdateSourceTrigger=PropertyChanged}" Height="30" FontSize="10pt" VerticalContentAlignment="Center" Padding="6,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 行5：三类人员 | 特种作业人员（两列均分） -->
                    <Grid Grid.Row="5" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="三类人员" FontSize="10pt" Foreground="#666" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ToggleButton x:Name="ThreeCategoryToggle" IsChecked="{Binding ThreeCategoryPersonnel}" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" Tag="ThreeCategory"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="特种作业人员" FontSize="10pt" Foreground="#666" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ToggleButton x:Name="SpecialOpsToggle" IsChecked="{Binding SpecialOperationsPersonnel}" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" Tag="SpecialOps"/>
                        </StackPanel>
                    </Grid>

                    <!-- 行6：备注 -->
                    <StackPanel Grid.Row="6">
                        <TextBlock Text="备注" FontSize="10pt" Foreground="#666" Margin="0,-3,0,2"/>
                        <TextBox x:Name="RemarkTextBox" Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" Height="30" FontSize="10pt" VerticalContentAlignment="Center" Padding="6,0"/>
                    </StackPanel>
                </Grid>

                <!-- ==================== 第二栏：身份证 ==================== -->
                <Border Grid.Column="1" BorderBrush="#DDD" BorderThickness="1,0,0,0" Padding="8,4,8,4" Margin="0,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="身份证" FontSize="10pt" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="IDCardFrontButton" Content="正面" Width="50" Height="24" Margin="0,0,4,0" Click="PhotoSlotButton_Click" Tag="IDCard_Front"/>
                            <Button x:Name="IDCardBackButton" Content="背面" Width="50" Height="24" Click="PhotoSlotButton_Click" Tag="IDCard_Back"/>
                        </StackPanel>

                        <Border x:Name="IDCardPhotoDisplayArea" Width="240" Height="180" MinWidth="240"
                                BorderBrush="#CCC" BorderThickness="1" CornerRadius="6" Background="#80FAFAFA"
                                AllowDrop="True" DragEnter="ImageDragEnter" Drop="ImageDrop" Margin="0,0,0,6"
                                MouseMove="PhotoDisplayArea_MouseMove" MouseLeave="PhotoDisplayArea_MouseLeave"
                                PreviewMouseRightButtonDown="PhotoDisplayArea_PreviewMouseRightButtonDown"
                                HorizontalAlignment="Stretch">
                            <Grid>
                                <TextBlock x:Name="IDCardPlaceholderText" Text="拖拽图片或点击按钮上传" 
                                           Foreground="Gray" TextAlignment="Center" VerticalAlignment="Center" Visibility="Visible" FontSize="10pt"/>
                                <Image x:Name="IDCardPhotoImage" Stretch="Uniform" Visibility="Collapsed"
                                       MouseLeftButtonDown="PhotoImage_MouseLeftButtonDown"/>
                                <!-- 左侧切换按钮 -->
                                <Button x:Name="IDCardPrevButton" 
                                        Content="《  " 
                                        HorizontalAlignment="Left" 
                                        VerticalAlignment="Center" 
                                        Margin="10,0,0,0" 
                                        Width="30" Height="50"
                                        FontSize="18" FontWeight="Bold"
                                        Background="#4C000000" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"
                                        Visibility="Collapsed"
                                        Click="PhotoPrevButton_Click"
                                        Tag="IDCard"/>
                                <!-- 右侧切换按钮 -->
                                <Button x:Name="IDCardNextButton" 
                                        Content="  》" 
                                        HorizontalAlignment="Right" 
                                        VerticalAlignment="Center" 
                                        Margin="0,0,10,0" 
                                        Width="30" Height="50"
                                        FontSize="18" FontWeight="Bold"
                                        Background="#4C000000" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"
                                        Visibility="Collapsed"
                                        Click="PhotoNextButton_Click"
                                        Tag="IDCard"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="证件编号" FontSize="10pt" Foreground="#666" Margin="0,0,0,3"/>
                        <TextBox x:Name="IDCardDocNumberTextBox" Text="{Binding IDCardDocNumber, UpdateSourceTrigger=PropertyChanged}" Height="30" FontSize="10pt" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,6"/>

                        <TextBlock Text="有效期" FontSize="10pt" Foreground="#666" Margin="0,0,0,3"/>
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="IDCardStartTextBox" Text="{Binding IDCardStart, UpdateSourceTrigger=PropertyChanged}" Height="30" FontSize="10pt" VerticalContentAlignment="Center" Padding="6,0"/>
                            <TextBlock Grid.Column="1" Text="至" Margin="4,0" VerticalAlignment="Center" FontSize="10pt" Foreground="#888"/>
                            <TextBox Grid.Column="2" x:Name="IDCardEndTextBox" Text="{Binding IDCardEnd, UpdateSourceTrigger=PropertyChanged}" Height="30" FontSize="10pt" VerticalContentAlignment="Center" Padding="6,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== 第三栏：其他证书 ==================== -->
                <Border Grid.Column="2" BorderBrush="#DDD" BorderThickness="1,0,0,0" Padding="8,4,8,4" Margin="0,0,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="其他证书" FontSize="10pt" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Grid Grid.Column="1" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="CertPhotoButton1" Content="1" Height="24" Margin="0,0,2,0" Click="PhotoSlotButton_Click" Tag="Cert_1"/>
                                <Button Grid.Column="1" x:Name="CertPhotoButton2" Content="2" Height="24" Margin="1,0,2,0" Click="PhotoSlotButton_Click" Tag="Cert_2"/>
                                <Button Grid.Column="2" x:Name="CertPhotoButton3" Content="3" Height="24" Margin="1,0,2,0" Click="PhotoSlotButton_Click" Tag="Cert_3"/>
                                <Button Grid.Column="3" x:Name="CertPhotoButton4" Content="4" Height="24" Margin="1,0,2,0" Click="PhotoSlotButton_Click" Tag="Cert_4"/>
                                <Button Grid.Column="4" x:Name="CertPhotoButton5" Content="5" Height="24" Margin="1,0,0,0" Click="PhotoSlotButton_Click" Tag="Cert_5"/>
                            </Grid>
                        </Grid>

                        <Border x:Name="CertPhotoDisplayArea" Width="240" Height="180" MinWidth="240"
                                BorderBrush="#CCC" BorderThickness="1" CornerRadius="6" Background="#80FAFAFA"
                                AllowDrop="True" DragEnter="ImageDragEnter" Drop="ImageDrop" Margin="0,0,0,6"
                                MouseMove="PhotoDisplayArea_MouseMove" MouseLeave="PhotoDisplayArea_MouseLeave"
                                PreviewMouseRightButtonDown="PhotoDisplayArea_PreviewMouseRightButtonDown"
                                HorizontalAlignment="Stretch">
                            <Grid>
                                <TextBlock x:Name="CertPlaceholderText" Text="拖拽图片或点击按钮上传"
                                           Foreground="Gray" TextAlignment="Center" VerticalAlignment="Center" Visibility="Visible" FontSize="10pt"/>
                                <Image x:Name="CertPhotoImage" Stretch="Uniform" Visibility="Collapsed"
                                       MouseLeftButtonDown="PhotoImage_MouseLeftButtonDown"/>
                                <!-- 左侧切换按钮 -->
                                <Button x:Name="CertPrevButton" 
                                        Content="《  " 
                                        HorizontalAlignment="Left" 
                                        VerticalAlignment="Center" 
                                        Margin="10,0,0,0" 
                                        Width="30" Height="50"
                                        FontSize="18" FontWeight="Bold"
                                        Background="#4C000000" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"
                                        Visibility="Collapsed"
                                        Click="PhotoPrevButton_Click"
                                        Tag="Certificate"/>
                                <!-- 右侧切换按钮 -->
                                <Button x:Name="CertNextButton" 
                                        Content="  》" 
                                        HorizontalAlignment="Right" 
                                        VerticalAlignment="Center" 
                                        Margin="0,0,10,0" 
                                        Width="30" Height="50"
                                        FontSize="18" FontWeight="Bold"
                                        Background="#4C000000" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"
                                        Visibility="Collapsed"
                                        Click="PhotoNextButton_Click"
                                        Tag="Certificate"/>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="证书名称" FontSize="10pt" Foreground="#666" Margin="0,0,0,3"/>
                                <TextBox x:Name="CertNameTextBox" Height="30" FontSize="10pt" VerticalContentAlignment="Center" Padding="6,0" TextChanged="CertTextBox_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="证书编号" FontSize="10pt" Foreground="#666" Margin="0,0,0,3"/>
                                <TextBox x:Name="CertDocNumberTextBox" Height="30" FontSize="10pt" VerticalContentAlignment="Center" Padding="6,0" TextChanged="CertTextBox_TextChanged"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="有效期" FontSize="10pt" Foreground="#666" Margin="0,0,0,3"/>
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="CertStartTextBox" Height="30" FontSize="10pt" VerticalContentAlignment="Center" Padding="6,0" TextChanged="CertTextBox_TextChanged"/>
                            <TextBlock Grid.Column="1" Text="至" Margin="4,0" VerticalAlignment="Center" FontSize="10pt" Foreground="#888"/>
                            <TextBox Grid.Column="2" x:Name="CertEndTextBox" Height="30" FontSize="10pt" VerticalContentAlignment="Center" Padding="6,0" TextChanged="CertTextBox_TextChanged"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
