<ui:FluentWindow x:Class="MS_SafetyManagementSystem.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:sysc="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
                 xmlns:converters="clr-namespace:MS_SafetyManagementSystem.ViewModels"
                 xmlns:tb="http://www.hardcodet.net/taskbar"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 xmlns:controls="clr-namespace:MS_SafetyManagementSystem.Controls"
                 Title="斜月安全管理系统"
                 Width="1000" Height="800"
                 MinWidth="800" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round"
                 WindowBackdropType="Acrylic"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType">

    <ui:FluentWindow.Resources>
        <!-- FauxMicaBrush 保留一份副本（MenuBar.xaml 中已有自己的副本） -->
        <LinearGradientBrush x:Key="FauxMicaBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#80F2F4F7" Offset="0.0"/>
            <GradientStop Color="#80EAEDF2" Offset="0.5"/>
            <GradientStop Color="#80F0F3F6" Offset="1.0"/>
        </LinearGradientBrush>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:BooleanToBrushConverter x:Key="BooleanToBrushConverter"/>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0"
                         Icon="pack://application:,,,/Resources/斜月安全管理系统256.png"
                         Title="{Binding WindowTitle}"
                         ShowMinimizeButton="True"
                         ShowMaximizeButton="True"/>

        <controls:MenuBar x:Name="MainMenuBar" Grid.Row="1"/>

        <!-- 主内容区统一背景层 -->
        <Border Background="#80FAFAFA" Grid.Row="2" Grid.RowSpan="2"/>

        <!-- 底板：模块面板（隐患 / 人员） -->
        <ContentControl x:Name="BasePanel" Grid.Row="2" Grid.RowSpan="2"
                        PreviewMouseLeftButtonDown="BasePanel_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="BasePanel_PreviewMouseMove" />

        <!-- 覆盖层背景（与主窗口背景色一致） -->
        <Border x:Name="OverlayBackground" Grid.Row="2" Grid.RowSpan="2"
                Background="#80FAFAFA" Visibility="Collapsed"/>

        <!-- 覆盖层：分析 / 导出（Z-Order 叠加在底板上方） -->
        <ContentControl x:Name="OverlayPanel" Grid.Row="2" Grid.RowSpan="2"
                        PreviewMouseLeftButtonDown="OverlayPanel_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="OverlayPanel_PreviewMouseMove" />
    </Grid>
</ui:FluentWindow>
