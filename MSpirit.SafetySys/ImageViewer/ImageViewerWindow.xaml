<Window x:Class="MS_SafetyManagementSystem.ImageViewer.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MS_SafetyManagementSystem.ImageViewer"
        xmlns:controls="clr-namespace:MS_SafetyManagementSystem.Controls"
        Title="斜月图片查看器"
        Width="Auto" Height="Auto"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#FAFAFA"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- 标题栏按钮基础样式 -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FF333333"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="39"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PART_Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#CC62CAC2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#CC49ADB2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭按钮样式 -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PART_Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#BF0F1A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 全屏底部按钮样式 -->
        <Style TargetType="Border" x:Key="FullScreenButtonStyle">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#AA2D2D2D"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <!-- 顶层 Grid：多子元素容器（Border + 全屏覆盖层） -->
    <Grid>
        <!-- 主内容 Border（圆角 + 浅色背景，普通模式下填充窗口） -->
        <Border x:Name="MainContentBorder"
                CornerRadius="8"
                ClipToBounds="True"
                Background="#FAFAFA"
                BorderBrush="#CCAAAAAA"
                BorderThickness="1">
            <Grid x:Name="ContentGrid"
                  MouseLeftButtonDown="Grid_MouseLeftButtonDown"
                  PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题栏（普通模式可见，全屏模式隐藏） -->
                <controls:WindowTitleBar x:Name="WindowTitleBarControl"
                                         Grid.Row="0"
                                         Panel.ZIndex="1"
                                         Title="斜月图片查看器"
                                         TitleFontSize="15"
                                         ShowIcon="False"
                                         TitleBarHeight="35"
                                         VerticalAlignment="Top"/>

                <!-- 图片渲染区域（ClipToBounds 裁剪容器，阻止旋转内容侵入标题栏） -->
                <Border x:Name="ImageClipBorder" Grid.Row="1" ClipToBounds="True">
                    <Image x:Name="ImageViewer"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5"
                           MouseLeftButtonDown="ImageViewer_MouseLeftButtonDown"
                           MouseWheel="ImageViewer_MouseWheel"
                           MouseMove="ImageViewer_MouseMove"
                           MouseLeftButtonUp="ImageViewer_MouseLeftButtonUp"
                           Cursor="Hand"
                           Source="{x:Null}">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                              Opacity="0.3" Color="Black"/>
                        </Image.Effect>
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="_scaleZoomTransform" ScaleX="1" ScaleY="1"/>
                                <RotateTransform x:Name="_rotateTransform" Angle="0"/>
                                <ScaleTransform x:Name="_flipTransform" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="_panTransform" X="0" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Border>

                <!-- 复制/提示信息浮层 -->
                <Border x:Name="CopyToast"
                        Grid.Row="1"
                        Background="#BB000000"
                        CornerRadius="8"
                        Padding="16,10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        Panel.ZIndex="20">
                    <TextBlock x:Name="CopyToastText"
                               Text="已复制到剪贴板"
                               Foreground="White"
                               FontFamily="Microsoft YaHei"
                               FontSize="12pt"/>
                </Border>
            </Grid>
        </Border>

        <!-- ===== 全屏覆盖层（窗口级，覆盖整个最大化窗口） ===== -->
        <Grid x:Name="FullScreenOverlay"
              Visibility="Collapsed">

            <!-- 底部统一容器（缩略图 + 信息 + 按钮，共享悬停淡入淡出） -->
            <Border x:Name="BottomBarWrapper"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    Opacity="0.1">
                <Border.Resources>
                    <Storyboard x:Key="FadeInStoryboard">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.59"/>
                    </Storyboard>
                    <Storyboard x:Key="FadeOutStoryboard">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.1" Duration="0:0:0.59"/>
                    </Storyboard>
                </Border.Resources>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}"/>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard Storyboard="{StaticResource FadeOutStoryboard}"/>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="69"/>
                        <RowDefinition Height="69"/>
                    </Grid.RowDefinitions>

                    <!-- 信息文字和按钮层 -->
                    <Grid Grid.Row="0" VerticalAlignment="Bottom">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="27"/>
                            <RowDefinition Height="2"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="10"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="InfoTextBlock"
                                   Grid.Row="0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Microsoft YaHei"
                                   FontSize="11pt"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="0"
                                                  Color="Black" Opacity="0.75"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <StackPanel Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Border x:Name="PrevButtonBorder"
                                    Style="{StaticResource FullScreenButtonStyle}"
                                    MouseLeftButtonDown="PrevButton_MouseLeftButtonDown"
                                    Margin="0,0,198,0"
                                    BorderThickness="0"
                                    Background="Transparent">
                                <TextBlock Text="《 《 《"
                                           FontFamily="华文彩云"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="0"
                                                          Color="Black" Opacity="0.75"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Border>

                            <Border x:Name="NextButtonBorder"
                                    Style="{StaticResource FullScreenButtonStyle}"
                                    MouseLeftButtonDown="NextButton_MouseLeftButtonDown"
                                    Margin="198,0,0,0"
                                    BorderThickness="0"
                                    Background="Transparent">
                                <TextBlock Text="》 》 》"
                                           FontFamily="华文彩云"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="0"
                                                          Color="Black" Opacity="0.75"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Border>

                            <TextBlock x:Name="SlideShowStatusText"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       FontFamily="Microsoft YaHei"
                                       FontSize="11pt"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <!-- 缩略图面板 -->
                    <Border Grid.Row="1"
                            Background="#AA2D2D2D"
                            CornerRadius="6,6,0,0">
                        <local:ImageViewerThumbnailPanel x:Name="SpiritThumbnailPanel"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
