<UserControl x:Class="MS_SafetyManagementSystem.Analysis.AnalysisControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:export="clr-namespace:MS_SafetyManagementSystem.Export"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:MS_SafetyManagementSystem.Controls">

    <UserControl.Resources>
        <export:BooleanToGrayBrushConverter x:Key="BooleanToGrayBrushConverter"/>

        <!-- 时间范围选择按钮统一样式（含悬停效果） -->
        <Style x:Key="TimeRangeButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="BorderBrush" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#17c3b2"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="BorderBrush" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatsCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10pt"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatsCardValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24pt"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#14B09B"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========== Row 0：时间范围选择区 ========== -->
        <Border Grid.Row="0" Background="Transparent" Padding="20,10,20,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="时间范围选择：" 
                           VerticalAlignment="Center" FontSize="11pt" Margin="0,0,10,0"/>

                <Button Content="本年" Width="66" FontSize="10pt" Height="30" Margin="0,0,5,0"
                        Command="{Binding SelectThisYearCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TimeRangeButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRangeType}" Value="thisYear">
                                    <Setter Property="Background" Value="#17c3b2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="上一年" Width="66" FontSize="10pt" Height="30" Margin="0,0,5,0"
                        Command="{Binding SelectPrevYearCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TimeRangeButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRangeType}" Value="prevYear">
                                    <Setter Property="Background" Value="#17c3b2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="本季度" Width="66" FontSize="10pt" Height="30" Margin="0,0,5,0"
                        Command="{Binding SelectThisQuarterCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TimeRangeButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRangeType}" Value="thisQuarter">
                                    <Setter Property="Background" Value="#17c3b2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="上季度" Width="66" FontSize="10pt" Height="30" Margin="0,0,5,0"
                        Command="{Binding SelectPrevQuarterCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TimeRangeButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRangeType}" Value="prevQuarter">
                                    <Setter Property="Background" Value="#17c3b2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="本月" Width="66" FontSize="10pt" Height="30" Margin="0,0,5,0"
                        Command="{Binding SelectThisMonthCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TimeRangeButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRangeType}" Value="thisMonth">
                                    <Setter Property="Background" Value="#17c3b2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="上月" Width="66" FontSize="10pt" Height="30" Margin="0,0,5,0"
                        Command="{Binding SelectPrevMonthCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TimeRangeButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRangeType}" Value="prevMonth">
                                    <Setter Property="Background" Value="#17c3b2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="自定义" Width="66" FontSize="10pt" Height="30" Margin="0,0,5,0" Padding="10,0"
                        Command="{Binding SelectCustomCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TimeRangeButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRangeType}" Value="custom">
                                    <Setter Property="Background" Value="#17c3b2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Border Height="30" Width="125" BorderBrush="White" BorderThickness="1" CornerRadius="6"
                        Background="Transparent" Cursor="Hand" x:Name="StartDateBorder" 
                        PreviewMouseLeftButtonDown="StartDateBorder_PreviewMouseLeftButtonDown" 
                        Margin="0,0,4,0"
                        IsHitTestVisible="{Binding IsCustomRangeSelectable}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="StartDateTextBox" Grid.Column="0" FontSize="10pt" 
                                 Text="{Binding CustomStartText, Mode=OneWay, FallbackValue='起始日期'}"
                                 BorderThickness="0" Background="Transparent" 
                                 VerticalContentAlignment="Center" Padding="3,-7,0,0"
                                 IsReadOnly="True" Cursor="Hand" Focusable="False"
                                 Style="{StaticResource BaseTextBoxStyle}"
                                 Foreground="{Binding IsCustomRangeSelectable, Converter={StaticResource BooleanToGrayBrushConverter}}"/>
                        <controls:ArrowToggleButton x:Name="StartDateToggleButton" Grid.Column="1"
                                                    Direction="Down"
                                                    VerticalAlignment="Center" Margin="0,0,3,0"
                                                    Focusable="False" IsHitTestVisible="False"
                                                    IsEnabled="{Binding IsCustomRangeSelectable}"/>
                    </Grid>
                </Border>

                <TextBlock Text="至" VerticalAlignment="Center" FontSize="10pt" 
                           Foreground="#888888" Margin="0,0,4,0"/>

                <Border Height="30" Width="125" BorderBrush="White" BorderThickness="1" CornerRadius="6"
                        Background="Transparent" Cursor="Hand" x:Name="EndDateBorder" 
                        PreviewMouseLeftButtonDown="EndDateBorder_PreviewMouseLeftButtonDown" 
                        Margin="0,0,4,0"
                        IsHitTestVisible="{Binding IsCustomRangeSelectable}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="EndDateTextBox" Grid.Column="0" FontSize="10pt" 
                                 Text="{Binding CustomEndText, Mode=OneWay, FallbackValue='结束日期'}"
                                 BorderThickness="0" Background="Transparent" 
                                 VerticalContentAlignment="Center" Padding="3,-7,0,0"
                                 IsReadOnly="True" Cursor="Hand" Focusable="False"
                                 Style="{StaticResource BaseTextBoxStyle}"
                                 Foreground="{Binding IsCustomRangeSelectable, Converter={StaticResource BooleanToGrayBrushConverter}}"/>
                        <controls:ArrowToggleButton x:Name="EndDateToggleButton" Grid.Column="1"
                                                    Direction="Down"
                                                    VerticalAlignment="Center" Margin="0,0,3,0"
                                                    Focusable="False" IsHitTestVisible="False"
                                                    IsEnabled="{Binding IsCustomRangeSelectable}"/>
                    </Grid>
                </Border>

                <Button Content="清空" Width="60" Height="30" 
                        FontSize="10pt" Style="{StaticResource BaseButtonStyle}"
                        BorderBrush="White"
                        Command="{Binding ClearCustomRangeCommand}"/>
            </StackPanel>
        </Border>

        <!-- ========== Row 1：统计指标概览 ========== -->
        <Border Grid.Row="1" Background="Transparent" Padding="20,5,20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Width="130" Height="80" CornerRadius="8" Margin="5,0"
                        Background="#1AFFFFFF" BorderBrush="#30CCCCCC" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="总记录数" Style="{StaticResource StatsCardTitleStyle}"/>
                        <TextBlock Text="{Binding TotalRecords}" Style="{StaticResource StatsCardValueStyle}"/>
                    </StackPanel>
                </Border>

                <Border Width="130" Height="80" CornerRadius="8" Margin="5,0"
                        Background="#1AFFFFFF" BorderBrush="#30CCCCCC" BorderThickness="1"
                        ToolTip="已填写隐患类型与级别、可参与类型分布统计的记录数">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="有效记录数" Style="{StaticResource StatsCardTitleStyle}"/>
                        <TextBlock Text="{Binding ValidRecordCount}" Style="{StaticResource StatsCardValueStyle}"/>
                    </StackPanel>
                </Border>

                <Border Width="130" Height="80" CornerRadius="8" Margin="5,0"
                        Background="#1AFFFFFF" BorderBrush="#30CCCCCC" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="隐患类型" Style="{StaticResource StatsCardTitleStyle}"/>
                        <TextBlock Text="{Binding HazardTypeCount}" Style="{StaticResource StatsCardValueStyle}"/>
                    </StackPanel>
                </Border>

                <Border Width="130" Height="80" CornerRadius="8" Margin="5,0"
                        Background="#1AFFFFFF" BorderBrush="#30CCCCCC" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="整改完成率" Style="{StaticResource StatsCardTitleStyle}"/>
                        <TextBlock Text="{Binding CompletionRateText}" Style="{StaticResource StatsCardValueStyle}"/>
                    </StackPanel>
                </Border>

                <Border x:Name="SummaryBorder" Width="248" Height="80" CornerRadius="8" Margin="5,0"
                        Background="#1AFFFFFF" BorderBrush="#30CCCCCC" BorderThickness="1"
                        PreviewMouseRightButtonDown="SummaryBorder_PreviewMouseRightButtonDown"
                        Cursor="Arrow">
                    <TextBlock Text="{Binding SummaryText, Mode=OneWay}"
                               FontSize="10pt" Foreground="#333333"
                               TextWrapping="Wrap"
                               Padding="8,12"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- ========== Row 2：数据分析区 ========== -->
        <Border Grid.Row="2" Background="Transparent" Padding="20,5,20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" 
                           Text="隐患类型分布数据" FontSize="11pt" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,15,8"/>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="隐患类型柱状图" FontSize="10pt" Height="28" Margin="0,0,8,0"
                            Command="{Binding SelectChartCommand}" CommandParameter="0" BorderBrush="White">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedChartIndex}" Value="0">
                                        <Setter Property="Background" Value="#17c3b2"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="隐患类型饼状图" FontSize="10pt" Height="28" Margin="0,0,8,0"
                            Command="{Binding SelectChartCommand}" CommandParameter="1" BorderBrush="White">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedChartIndex}" Value="1">
                                        <Setter Property="Background" Value="#17c3b2"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="隐患数量折线图(日)" FontSize="10pt" Height="28" Margin="0,0,8,0"
                            Command="{Binding SelectChartCommand}" CommandParameter="2" BorderBrush="White">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedChartIndex}" Value="2">
                                        <Setter Property="Background" Value="#17c3b2"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="隐患数量折线图(月)" FontSize="10pt" Height="28"
                            Command="{Binding SelectChartCommand}" CommandParameter="3" BorderBrush="White">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedChartIndex}" Value="3">
                                        <Setter Property="Background" Value="#17c3b2"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Border Grid.Row="1" Grid.Column="0" Background="#1AFFFFFF" BorderBrush="Transparent"
                        BorderThickness="1" CornerRadius="8" Padding="0" Margin="0,0,15,0">
                    <DataGrid Style="{StaticResource DataGridStyle}"
                              AutoGenerateColumns="False"
                              ItemsSource="{Binding TypeDistribution}"
                              Width="260"
                              Background="Transparent" RowHeight="30" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号" Width="45" Binding="{Binding SequenceNumber}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="隐患类型" Width="*" Binding="{Binding HazardType}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="4,0,0,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="数量" Width="55" Binding="{Binding Count}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="占比" Width="65" Binding="{Binding PercentageText}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="1" Grid.Column="1"
                        Background="#1AFFFFFF" BorderBrush="#30CCCCCC" 
                        BorderThickness="1" CornerRadius="8" Padding="8">
                    <Grid>
                        <lvc:CartesianChart Series="{Binding BarSeries}"
                                            XAxes="{Binding BarXAxes}" YAxes="{Binding BarYAxes}"
                                            ZoomMode="X" TooltipPosition="Hidden">
                            <lvc:CartesianChart.Style>
                                <Style TargetType="lvc:CartesianChart">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedChartIndex}" Value="0">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="IsHitTestVisible" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </lvc:CartesianChart.Style>
                        </lvc:CartesianChart>

                        <lvc:PieChart Series="{Binding PieSeries}" TooltipPosition="Top">
                            <lvc:PieChart.Style>
                                <Style TargetType="lvc:PieChart">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedChartIndex}" Value="1">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="IsHitTestVisible" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </lvc:PieChart.Style>
                        </lvc:PieChart>

                        <lvc:CartesianChart Series="{Binding DailySeries}"
                                            XAxes="{Binding DailyXAxes}" YAxes="{Binding DailyYAxes}"
                                            ZoomMode="X" TooltipPosition="Top">
                            <lvc:CartesianChart.Style>
                                <Style TargetType="lvc:CartesianChart">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedChartIndex}" Value="2">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="IsHitTestVisible" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </lvc:CartesianChart.Style>
                        </lvc:CartesianChart>

                        <lvc:CartesianChart Series="{Binding MonthlySeries}"
                                            XAxes="{Binding MonthlyXAxes}" YAxes="{Binding MonthlyYAxes}"
                                            ZoomMode="X" TooltipPosition="Top">
                            <lvc:CartesianChart.Style>
                                <Style TargetType="lvc:CartesianChart">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedChartIndex}" Value="3">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="IsHitTestVisible" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </lvc:CartesianChart.Style>
                        </lvc:CartesianChart>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1" Grid.Column="1" 
                           Text="{Binding StatusText}" 
                           Foreground="Blue" FontSize="10pt"
                           VerticalAlignment="Bottom" Margin="0,5,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <!-- ========== Row 3：底部按钮行 ========== -->
        <Border Grid.Row="3" Background="Transparent" Padding="20,5,30,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="导出数据表" Width="95" Height="30" Margin="0,0,10,0"
                        FontSize="10pt" Style="{StaticResource BaseButtonStyle}" BorderBrush="White"
                        Command="{Binding ExportTableCommand}"/>
                <Button Content="导出图表" Width="95" Height="30" Margin="0,0,10,0"
                        FontSize="10pt" Style="{StaticResource BaseButtonStyle}" BorderBrush="White"
                        Command="{Binding ExportPngCommand}"/>
                <Button Content="退出数据分析" Width="105" Height="30" 
                        FontSize="10pt" Style="{StaticResource BaseButtonStyle}" BorderBrush="White"
                        Click="ExitButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
