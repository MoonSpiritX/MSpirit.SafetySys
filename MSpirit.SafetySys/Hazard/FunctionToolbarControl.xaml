<UserControl x:Class="MS_SafetyManagementSystem.Hazard.FunctionToolbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="Transparent" Padding="10,5"
            PreviewMouseLeftButtonDown="FunctionArea_MouseLeftButtonDown"
            PreviewMouseMove="FunctionArea_MouseMove">
        <Border.Resources>
            <Style TargetType="Button">
                <Setter Property="Margin" Value="5,0"/>
                <Setter Property="Width" Value="85"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="White"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#CC17c3b2"/>
                                    <Setter Property="BorderBrush" Value="#888888"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.2" Color="Black"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#CCCCCC"/>
                                    <Setter Property="BorderBrush" Value="#666666"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="2" ShadowDepth="0" Opacity="0.2" Color="Black"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.6"/>
                                    <Setter Property="Foreground" Value="#888888"/>
                                    <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.Resources>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 分组操作区 -->
            <GroupBox Header="分组操作区" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Stretch" Width="210">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="{Binding CreateGroupButtonText}" Command="{Binding CreateGroupCommand}" Margin="0,0,5,0"/>
                    <Button Content="{Binding AddDateButtonText}" Command="{Binding GroupTree.AddDateCommand}" Margin="5,0,0,0"/>
                </StackPanel>
            </GroupBox>
            <!-- 记录操作区 -->
            <GroupBox Header="记录操作区" Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Stretch" Width="320">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="{Binding AddCardButtonText}" Command="{Binding Records.AddRecordCommand}" Margin="0,5,5,5"/>
                    <Button Content="{Binding ClearCardsButtonText}" Command="{Binding Records.ClearCardsContentCommand}" Margin="5,5,5,5"/>
                    <Button Content="{Binding DeleteRecordButtonText}" Command="{Binding Records.DeleteSelectedRecordsCommand}" Margin="5,5,0,5"/>
                </StackPanel>
            </GroupBox>
            <!-- 数据操作区 -->
            <GroupBox Header="数据操作区" Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Stretch" Width="210">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="导入导出" Click="OnDataExport" Margin="0,0,5,0"/>
                    <Button Content="数据分析" Click="OnDataAnalysis" Margin="5,0,0,0"/>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Border>
</UserControl>
