<UserControl x:Class="MS_SafetyManagementSystem.Hazard.RecordCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:controls="clr-namespace:MS_SafetyManagementSystem.Controls"
             mc:Ignorable="d" 
             Height="Auto" d:DesignWidth="630" MinWidth="636"
             Background="transparent"
             x:Name="RootControl">

    <UserControl.Resources>
        <Style x:Key="SquareRoundCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Width="18" Height="18" CornerRadius="4" Background="Transparent"
                                BorderBrush="#CCFFFFFF" BorderThickness="1">
                            <Border x:Name="checkMark" Background="Transparent" CornerRadius="3" Margin="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Background" Value="#14B09B"/>
                                <Setter Property="BorderBrush" Value="#14B09B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="11pt"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="FontSize" Value="10.5pt"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Margin="2,0,3,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F0F0F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Height" Value="35"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCFAFAFA"/>
            <Setter Property="Background" Value="#7FFAFAFA"/>
            <Setter Property="Padding" Value="3,0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="10pt"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#CCFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#17c3b2"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0f8f82"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <x:Array x:Key="HazardLevelList" Type="sys:String">
            <sys:String>一般</sys:String>
            <sys:String>重大</sys:String>
        </x:Array>
    </UserControl.Resources>

    <!-- 根 Grid -->
    <Grid>
        <Border x:Name="CardBorder" BorderBrush="#19528BD6" BorderThickness="2" Padding="0,5,0,0" CornerRadius="5" Margin="2"
                Background="Transparent"
                PreviewMouseRightButtonDown="CardBorder_PreviewMouseRightButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.1" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="95"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第1行 -->
                <Grid Grid.Row="0" Margin="8,5,8,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10*"/>
                        <ColumnDefinition Width="10*"/>
                        <ColumnDefinition Width="8*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="序号：" Width="40" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DisplayIndex}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="26,0,0,0" Style="{StaticResource SquareRoundCheckBoxStyle}" Focusable="False"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                        <TextBlock Text="责任单位：" VerticalAlignment="Center"/>
                        <TextBox x:Name="ResponsibleUnitTextBox" 
                                 Text="{Binding ResponsibleUnit, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="120" Margin="5,0,0,0" Height="35" VerticalContentAlignment="Center"
                                 PreviewMouseRightButtonDown="TextBox_PreviewMouseRightButtonDown" 
                                 PreviewKeyDown="TextBox_PreviewKeyDown" 
                                 ContextMenu="{x:Null}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="责任人：" VerticalAlignment="Center"/>
                        <TextBox x:Name="ResponsiblePersonTextBox" 
                                 Text="{Binding ResponsiblePerson, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="98" Margin="5,0,0,0" Height="35" VerticalContentAlignment="Center"
                                 PreviewMouseRightButtonDown="TextBox_PreviewMouseRightButtonDown" 
                                 PreviewKeyDown="TextBox_PreviewKeyDown" 
                                 ContextMenu="{x:Null}"/>
                    </StackPanel>
                </Grid>

                <!-- 第2行 -->
                <Grid Grid.Row="1" Margin="8,5,8,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10*"/>
                        <ColumnDefinition Width="10*"/>
                        <ColumnDefinition Width="8*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="隐患位置：" VerticalAlignment="Center"/>
                        <TextBox x:Name="LocationTextBox" 
                                 Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" FontSize="11pt"
                                 Width="120" Margin="5,0,0,0" Height="35" VerticalContentAlignment="Center"
                                 PreviewMouseRightButtonDown="TextBox_PreviewMouseRightButtonDown" 
                                 PreviewKeyDown="TextBox_PreviewKeyDown" 
                                 ContextMenu="{x:Null}"/>
                    </StackPanel>

                    <!-- 隐患类型 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                        <TextBlock Text="隐患类型：" VerticalAlignment="Center"/>
                        <Border x:Name="HazardTypeBorder" 
                                BorderBrush="#CCFFFFFF" BorderThickness="1" CornerRadius="6" 
                                Background="#80FAFAFA" Height="35" Width="120" 
                                Margin="5,0,0,0" Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="HazardTypeTextBlock"
                                           FontSize="11pt"
                                           Grid.Column="0"
                                           Text="{Binding HazardType, TargetNullValue=''}"
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Left"
                                           Padding="7,0"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding HazardType}"/>
                                <controls:ArrowToggleButton x:Name="HazardTypeToggleButton" 
                                                            Grid.Column="1"
                                                            Direction="Down"
                                                            VerticalAlignment="Center" Margin="0,0,4,0"
                                                            IsHitTestVisible="False"
                                                            Focusable="False"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 隐患级别 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="级　别：" VerticalAlignment="Center"/>
                        <Border x:Name="HazardLevelBorder" 
                                BorderBrush="#CCFFFFFF" BorderThickness="1" CornerRadius="6" 
                                Background="#80FAFAFA" Height="35" Width="98" 
                                Margin="5,0,0,0" Cursor="Hand" 
                                PreviewMouseLeftButtonDown="HazardLevelBorder_PreviewMouseLeftButtonDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="HazardLevelTextBlock" 
                                           FontSize="11pt"
                                           Grid.Column="0"
                                           Text="{Binding HazardLevel, TargetNullValue='请选择'}"
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Left"
                                           Padding="8,0"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding HazardLevel}"/>
                                <controls:ArrowToggleButton x:Name="HazardLevelToggleButton" 
                                                            Grid.Column="1"
                                                            Direction="Down"
                                                            VerticalAlignment="Center" Margin="0,0,4,0"
                                                            IsHitTestVisible="False"
                                                            Focusable="False"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 第3行 -->
                <Grid Grid.Row="2" Margin="8,5,8,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10*"/>
                        <ColumnDefinition Width="10*"/>
                        <ColumnDefinition Width="8*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="整改期限：" VerticalAlignment="Center"/>
                        <controls:DateFieldPicker x:Name="DeadlinePicker" SelectedDate="{Binding Deadline}" Margin="5,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                        <TextBlock Text="完成日期：" VerticalAlignment="Center"/>
                        <controls:DateFieldPicker x:Name="CompletedDatePicker" SelectedDate="{Binding CompletedDate}" Margin="5,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="复查人：" VerticalAlignment="Center"/>
                        <TextBox x:Name="ReviewerTextBox" 
                                 Text="{Binding Reviewer, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="98" Margin="5,0,0,0" Height="35" VerticalContentAlignment="Center"
                                 PreviewMouseRightButtonDown="TextBox_PreviewMouseRightButtonDown" 
                                 PreviewKeyDown="TextBox_PreviewKeyDown" 
                                 ContextMenu="{x:Null}"/>
                    </StackPanel>
                </Grid>

                <!-- 第4行 -->
                <Grid Grid.Row="3" Margin="8,5,8,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,0,0">
                        <TextBlock Text="隐患描述：" Margin="0,0,0,5"/>
                        <TextBox x:Name="DescriptionTextBox" FontSize="11pt"
                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="55"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 Padding="3,3"
                                 PreviewMouseRightButtonDown="TextBox_PreviewMouseRightButtonDown"
                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                 ContextMenu="{x:Null}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,0,0">
                        <TextBlock Text="整改措施：" Margin="0,0,0,5"/>
                        <TextBox x:Name="MeasureTextBox" FontSize="11pt"
                                 Text="{Binding Measure, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="55"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 Padding="3,3"
                                 PreviewMouseRightButtonDown="TextBox_PreviewMouseRightButtonDown"
                                 PreviewKeyDown="TextBox_PreviewKeyDown"
                                 ContextMenu="{x:Null}"/>
                    </StackPanel>
                </Grid>

                <!-- 第5行：隐患照片按钮区 -->
                <Grid Grid.Row="4" Margin="8,5,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="隐患照片:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button x:Name="HazardPhotoButton1" Focusable="False" Content="1" Width="40" Margin="10,0,5,0" Click="PhotoButton_Click" Tag="Hazard_1"/>
                        <Button x:Name="HazardPhotoButton2" Focusable="False" Content="2" Width="40" Margin="5,0" Click="PhotoButton_Click" Tag="Hazard_2"/>
                        <Button x:Name="HazardPhotoButton3" Focusable="False" Content="3" Width="40" Margin="5,0" Click="PhotoButton_Click" Tag="Hazard_3"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="整改照片:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button x:Name="RemedyPhotoButton1" Focusable="False" Content="1" Width="40" Margin="10,0,5,0" Click="PhotoButton_Click" Tag="Remedy_1"/>
                        <Button x:Name="RemedyPhotoButton2" Focusable="False" Content="2" Width="40" Margin="5,0" Click="PhotoButton_Click" Tag="Remedy_2"/>
                        <Button x:Name="RemedyPhotoButton3" Focusable="False" Content="3" Width="40" Margin="5,0" Click="PhotoButton_Click" Tag="Remedy_3"/>
                    </StackPanel>
                </Grid>

                <!-- 第6行：图片显示区（含动态按钮） -->
                <Grid Grid.Row="5" Margin="8,5,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="225"/>
                    </Grid.RowDefinitions>

                    <!-- 隐患照片显示区 -->
                    <Border x:Name="HazardPhotoDisplayArea" Grid.Column="0"  
                            BorderBrush="White" BorderThickness="1" CornerRadius="4" Background="#80FAFAFA" 
                            AllowDrop="True" DragEnter="ImageDragEnter" Drop="ImageDrop" Margin="0,0,0,0"
                            MouseMove="PhotoDisplayArea_MouseMove" MouseLeave="PhotoDisplayArea_MouseLeave"
                            PreviewMouseRightButtonDown="PhotoDisplayArea_PreviewMouseRightButtonDown">
                        <Grid>
                            <TextBlock x:Name="HazardPlaceholderText" Text="请将图片拖拽至此区域&#x0a;或右键此区域添加图片" 
                                       Foreground="Gray" TextAlignment="Center" VerticalAlignment="Center" 
                                       Visibility="Visible"/>
                            <Image x:Name="HazardPhotoImage" Stretch="Uniform" Visibility="Collapsed"
                                   ContextMenu="{x:Null}"
                                   MouseLeftButtonDown="PhotoImage_MouseLeftButtonDown"/>
                            <!-- 左侧切换按钮 -->
                            <Button x:Name="HazardPrevButton" 
                                    Content="《  " 
                                    HorizontalAlignment="Left" 
                                    VerticalAlignment="Center" 
                                    Margin="10,0,0,0" 
                                    Width="30" Height="50"
                                    FontSize="18" FontWeight="Bold"
                                    Background="#4C000000" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"
                                    Visibility="Collapsed"
                                    Click="PhotoPrevButton_Click"
                                    Tag="Hazard"/>
                            <!-- 右侧切换按钮 -->
                            <Button x:Name="HazardNextButton" 
                                    Content="  》" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Center" 
                                    Margin="0,0,10,0" 
                                    Width="30" Height="50"
                                    FontSize="18" FontWeight="Bold"
                                    Background="#4C000000" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"
                                    Visibility="Collapsed"
                                    Click="PhotoNextButton_Click"
                                    Tag="Hazard"/>
                        </Grid>
                    </Border>

                    <!-- 整改照片显示区 -->
                    <Border x:Name="RemedyPhotoDisplayArea" Grid.Column="2" 
                            BorderBrush="White" BorderThickness="1" CornerRadius="4" Background="#80FAFAFA" 
                            AllowDrop="True" DragEnter="ImageDragEnter" Drop="ImageDrop" Margin="0,0,0,0"
                            MouseMove="PhotoDisplayArea_MouseMove" MouseLeave="PhotoDisplayArea_MouseLeave"
                            PreviewMouseRightButtonDown="PhotoDisplayArea_PreviewMouseRightButtonDown">
                        <Grid>
                            <TextBlock x:Name="RemedyPlaceholderText" Text="请将图片拖拽至此区域&#x0a;或右键此区域添加图片" 
                                       Foreground="Gray" TextAlignment="Center" VerticalAlignment="Center" 
                                       Visibility="Visible"/>
                            <Image x:Name="RemedyPhotoImage" Stretch="Uniform" Visibility="Collapsed"
                                   ContextMenu="{x:Null}"
                                   MouseLeftButtonDown="PhotoImage_MouseLeftButtonDown"/>
                            <!-- 左侧切换按钮 -->
                            <Button x:Name="RemedyPrevButton" 
                                    Content="《  " 
                                    HorizontalAlignment="Left" 
                                    VerticalAlignment="Center" 
                                    Margin="10,0,0,0" 
                                    Width="30" Height="50"
                                    FontSize="18" FontWeight="Bold"
                                    Background="#4C000000" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"
                                    Visibility="Collapsed"
                                    Click="PhotoPrevButton_Click"
                                    Tag="Remedy"/>
                            <!-- 右侧切换按钮 -->
                            <Button x:Name="RemedyNextButton" 
                                    Content="  》" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Center" 
                                    Margin="0,0,10,0" 
                                    Width="30" Height="50"
                                    FontSize="18" FontWeight="Bold"
                                    Background="#4C000000" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"
                                    Visibility="Collapsed"
                                    Click="PhotoNextButton_Click"
                                    Tag="Remedy"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- 隐患类型主菜单 Popup -->
        <Popup x:Name="HazardTypePopup" 
               StaysOpen="True" 
               AllowsTransparency="True" 
               Placement="Bottom" 
               PlacementTarget="{Binding ElementName=HazardTypeBorder}"
               PopupAnimation="Slide">
            <Grid Margin="8">
                <Border Background="#3F000000" CornerRadius="6" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform X="2" Y="2"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <BlurEffect Radius="6" KernelType="Gaussian"/>
                    </Border.Effect>
                </Border>
                <Border Background="#E5AAAAAA" BorderBrush="#E5AAAAAA" BorderThickness="1" CornerRadius="6" Padding="5">
                    <StackPanel x:Name="HazardTypeMenuPanel" MinWidth="120"/>
                </Border>
            </Grid>
        </Popup>

        <!-- 子菜单：全量类型 -->
        <Popup x:Name="FullTypeSubPopup" 
               StaysOpen="False" 
               AllowsTransparency="True" 
               Placement="Right" 
               PlacementTarget="{Binding ElementName=MoreTypesButton}"
               PopupAnimation="Slide">
            <Grid Margin="8">
                <Border Background="#3F000000" CornerRadius="6" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform X="2" Y="2"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <BlurEffect Radius="6" KernelType="Gaussian"/>
                    </Border.Effect>
                </Border>
                <Border Background="#E5AAAAAA" BorderBrush="#E5AAAAAA" BorderThickness="1" CornerRadius="6" Padding="5">
                    <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                        <UniformGrid x:Name="FullTypeGrid" Columns="3" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Popup>

    </Grid>
</UserControl>
