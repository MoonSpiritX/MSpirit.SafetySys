<ui:FluentWindow x:Class="MS_SafetyManagementSystem.Views.ManageProjectsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:MS_SafetyManagementSystem.Controls"
                 xmlns:helpers="clr-namespace:MS_SafetyManagementSystem.Helpers"
                 Title="项目及存档管理"
                 Width="750" Height="570"
                 MinWidth="700" MinHeight="570"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResizeWithGrip"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 helpers:WindowDragHelper.EnableDrag="True">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <!-- 全局字号 11pt -->
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="11pt"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="11pt"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="11pt"/>
        </Style>
    </ui:FluentWindow.Resources>


    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 全局标题栏 -->
        <controls:WindowTitleBar Grid.Row="0"
                                 Icon="pack://application:,,,/Resources/斜月安全管理系统图标256.png"
                                 Title="{Binding CurrentProjectName}"
                                 ShowMinimizeButton="False"
                                 ShowMaximizeButton="False"/>

        <!-- 内容区域 -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧按钮区 -->
            <StackPanel Grid.Column="0" Width="120" Margin="0,0,15,0">
                <TextBox x:Name="SearchTextBox"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Tag="搜索项目"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="输入项目名称字段进行搜索"/>
                <Separator Margin="0,5,0,5" Background="#CCCCCC"/>

                <Button Content="选择项目" Command="{Binding SelectProjectCommand}" Style="{StaticResource SidePanelButtonStyle}"/>
                <Button Content="新建项目" Command="{Binding NewCommand}" Style="{StaticResource SidePanelButtonStyle}"/>
                <Button Content="编辑名称" Command="{Binding RenameCommand}" Style="{StaticResource SidePanelButtonStyle}"/>
                <Button Content="删除项目" Command="{Binding DeleteCommand}" Style="{StaticResource SidePanelButtonStyle}"/>
                <Separator Margin="0,5,0,5" Background="#CCCCCC"/>

                <Button Content="置顶项目" Command="{Binding TopCommand}" Style="{StaticResource SidePanelButtonStyle}"/>
                <Button Content="上移项目" Command="{Binding UpCommand}" Style="{StaticResource SidePanelButtonStyle}"/>
                <Button Content="下移项目" Command="{Binding DownCommand}" Style="{StaticResource SidePanelButtonStyle}"/>
                <Button Content="移至最后" Command="{Binding BottomCommand}" Style="{StaticResource SidePanelButtonStyle}"/>
                <Separator Margin="0,5,0,5" Background="#CCCCCC"/>

                <Button Content="关闭" Command="{Binding CloseCommand}" Style="{StaticResource SidePanelButtonStyle}"/>
            </StackPanel>

            <!-- 右侧区域：项目列表 + 底部按钮行 + 提示行 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="ProjectsDataGrid"
                          Grid.Row="0"
                      Style="{StaticResource DataGridStyle}"
                      Grid.Column="1"
                      ItemsSource="{Binding Projects}"
                      SelectedItem="{Binding SelectedProject}"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      BorderBrush="#DDDDDD"
                      BorderThickness="1"
                      BeginningEdit="ProjectsDataGrid_BeginningEdit"
                      MouseDoubleClick="ProjectsDataGrid_MouseDoubleClick"
                      Background="Transparent">

                <DataGrid.Columns>
                    <!-- 选择列：勾选用于导出存档（表头文本，覆盖全局列头左对齐样式） -->
                    <DataGridTemplateColumn Width="50" CanUserSort="False" CanUserResize="False">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="选择" VerticalAlignment="Center"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}"
                                          Click="RowCheckBox_Click"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ToolTip="勾选后可通过底部按钮导出存档"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="序号" Width="50" Binding="{Binding Index}" IsReadOnly="True">
                        <!-- 表头居中，与单元格数字对齐（覆盖全局列头左对齐样式） -->
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <!-- 必须 Stretch 撑满单元格宽度，TextAlignment 才能居中（TextBlock 宽度=文字宽度时对齐无效） -->
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="项目名称" Width="*" Binding="{Binding Name}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Left"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <StaticResource ResourceKey="DataGridEditTextBoxStyle"/>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="创建日期" Width="120" Binding="{Binding Created}" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Left"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <StaticResource ResourceKey="DataGridEditTextBoxStyle"/>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
                </DataGrid>

                <!-- 底部按钮行：存档导入导出 -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding SelectedCountText}"
                               VerticalAlignment="Center" Foreground="#666666"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="全选/取消" Width="90" Height="30"
                                Command="{Binding ToggleSelectAllCommand}"
                                Style="{StaticResource SidePanelButtonStyle}"/>
                        <Button Content="导出选中项目" Width="110" Height="30" Margin="8,0,0,0"
                                Command="{Binding ExportSelectedCommand}"
                                Style="{StaticResource SidePanelButtonStyle}"/>
                        <Button Content="导入存档" Width="90" Height="30" Margin="8,0,0,0"
                                Command="{Binding ImportArchiveCommand}"
                                Style="{StaticResource SidePanelButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- 选中逻辑提示行：左侧按钮针对行选中，底部导出针对复选框勾选 -->
                <TextBlock Grid.Row="2" Margin="0,6,0,0"
                           Text="提示：左侧操作按钮针对【选中的行】（单击行选中）；底部『导出相关按钮』针对【勾选的复选框】选择的内容"
                           FontSize="10pt" Foreground="#999999" TextWrapping="Wrap"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>