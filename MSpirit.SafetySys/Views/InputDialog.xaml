<ui:FluentWindow x:Class="MS_SafetyManagementSystem.Views.InputDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:MS_SafetyManagementSystem.Controls"
                 Title="输入"
                 Width="450" SizeToContent="Height"
                 MinWidth="400" MinHeight="180"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar x:Name="TitleBarControl"
                                 Grid.Row="0"
                                 Icon="pack://application:,,,/Resources/FoolMoon.png"
                                 Title="输入"
                                 ShowMinimizeButton="False"
                                 ShowMaximizeButton="False"/>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Vertical" Margin="0,0,0,15">
                <TextBlock Text="请输入名称：" Margin="0,0,0,5"/>
                <TextBox x:Name="InputTextBox" Style="{StaticResource BaseTextBoxStyle}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确定" Style="{StaticResource DialogButtonStyle}" Click="OkButton_Click" IsDefault="True"/>
                <Button Content="取消" Style="{StaticResource DialogButtonStyle}" Click="CancelButton_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>