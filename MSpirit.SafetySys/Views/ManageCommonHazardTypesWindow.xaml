<ui:FluentWindow x:Class="MS_SafetyManagementSystem.Views.ManageCommonHazardTypesWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:MS_SafetyManagementSystem.Controls"
                 xmlns:helpers="clr-namespace:MS_SafetyManagementSystem.Helpers"
                 Title="常用隐患类型管理"
                 SizeToContent="Height"
                 MinWidth="750" MinHeight="550"
                 Width="999"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 helpers:WindowDragHelper.EnableDrag="True">

    <ui:FluentWindow.Resources>
        <!-- 常用类型项按钮：透明圆角（视觉与原 Border 一致），真 Button 以便拖拽白名单豁免 -->
        <Style x:Key="CommonTypeItemStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#CCCDCDCD" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#AACDCDCD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#8FCDCDCD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </ui:FluentWindow.InputBindings>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0"
                                 Icon="pack://application:,,,/Resources/FoolMoon.png"
                                 Title="常用隐患类型管理"
                                 ShowMinimizeButton="False"
                                 ShowMaximizeButton="False"/>

        <!-- 模式选择区域 -->
        <StackPanel Grid.Row="1" Margin="15,10,15,5">
            <TextBlock Text="选择隐患类型交互方式" FontSize="11pt" Margin="0,0,0,8" Foreground="#555"/>
            <RadioButton x:Name="FullWindowRadio" Content="全量窗口" GroupName="SelectorMode" 
                         IsChecked="{Binding IsFullWindowMode}" Margin="0,3" Checked="Mode_Changed"/>
            <RadioButton x:Name="DropdownMenuRadio" Content="下拉菜单" GroupName="SelectorMode" 
                         IsChecked="{Binding IsDropdownMenuMode}" Margin="0,3" Checked="Mode_Changed"/>
            <TextBlock Text="全量窗口模式：点击隐患类型区域直接打开全量类型窗口进行选择（无需常用类型）" 
                       FontSize="9pt" Foreground="Gray" Margin="20,0,0,5" TextWrapping="Wrap"/>
            <TextBlock Text="下拉菜单模式：显示常用类型列表，并提供全量类型的子菜单（需配置下方常用类型）" 
                       FontSize="9pt" Foreground="Gray" Margin="20,0,0,5" TextWrapping="Wrap"/>
            <Separator Margin="0,10,0,10"/>
        </StackPanel>

        <!-- 类型列表区域：使用 UniformGrid 实现均匀填满 -->
        <Grid Grid.Row="2" Margin="10,0,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="勾选常用的隐患类型（顺序按原列表固定）" 
                       FontSize="11pt" Margin="0,0,0,10" Foreground="#555"/>
            <ScrollViewer x:Name="TypesScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding AllTypes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 真 Button（ButtonBase）：拖拽白名单自动豁免，且点击语义完整 -->
                            <Button Height="40" Margin="5" Cursor="Hand"
                                    Style="{StaticResource CommonTypeItemStyle}"
                                    Click="CommonTypeButton_Click">
                                <CheckBox Content="{Binding Name}" 
                  IsChecked="{Binding IsSelected}"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="12,0,0,0"
                  FontSize="11pt"
                  IsHitTestVisible="False"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,15,15">
            <Button Content="确定" Command="{Binding SaveCommand}" Style="{StaticResource DialogButtonStyle}" IsDefault="True" Margin="0,0,10,0"/>
            <Button Content="取消" Command="{Binding CancelCommand}" Style="{StaticResource DialogButtonStyle}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>