<ui:FluentWindow x:Class="MS_SafetyManagementSystem.Views.OrphanRecordScannerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:MS_SafetyManagementSystem.Controls"
                 Title="非标准记录扫描"
                 Width="800" Height="500"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar x:Name="TitleBarControl"
                                 Grid.Row="0"
                                 Icon="pack://application:,,,/Resources/斜月安全管理系统图标256.png"
                                 Title="非标准记录扫描"
                                 ShowMinimizeButton="False"
                                 ShowMaximizeButton="False"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧按钮区 -->
            <StackPanel Grid.Column="0" Margin="10" VerticalAlignment="Top">
                <Button Content="扫描" Width="100" Height="30" Margin="0,0,0,10"
                        Style="{StaticResource BaseButtonStyle}" BorderBrush="White"
                        Click="ScanButton_Click"/>
                <Button Content="删除选中" Width="100" Height="30" Margin="0,0,0,10"
                        Style="{StaticResource BaseButtonStyle}" BorderBrush="White"
                        Click="DeleteSelectedButton_Click"/>
                <Button Content="删除全部" Width="100" Height="30" Margin="0,0,0,10"
                        Style="{StaticResource BaseButtonStyle}" BorderBrush="White"
                        Click="DeleteAllButton_Click"/>
                <Button x:Name="MoveSelectedButton" Content="移动选中" Width="100" Height="30" Margin="0,0,0,10"
                        Style="{StaticResource BaseButtonStyle}" BorderBrush="White"
                        Click="MoveSelectedButton_Click"/>
            </StackPanel>

            <!-- 右侧列表 -->
            <DataGrid Grid.Column="1" x:Name="ResultDataGrid"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      Margin="5" BorderBrush="#DDDDDD"
                      AlternationCount="2"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="序号" Width="50" Binding="{Binding Index}"/>
                    <DataGridTextColumn Header="所属项目" Width="120" Binding="{Binding ProjectName}"/>
                    <DataGridTextColumn Header="所属模块" Width="90" Binding="{Binding ModuleName}"/>
                    <DataGridTextColumn Header="一级分组" Width="120" Binding="{Binding Level1Group}"/>
                    <DataGridTextColumn Header="二级分组" Width="120" Binding="{Binding Level2Group}"/>
                    <DataGridTextColumn Header="记录摘要" Width="*" Binding="{Binding RecordSummary}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</ui:FluentWindow>
