<ui:FluentWindow x:Class="MS_SafetyManagementSystem.Views.SelectPersonnelGroupDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:MS_SafetyManagementSystem.Controls"
                 Title="选择目标分组"
                 Width="380" SizeToContent="Height"
                 MinWidth="320" MinHeight="300"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar x:Name="TitleBarControl"
                                 Grid.Row="0"
                                 Icon="pack://application:,,,/Resources/斜月安全管理系统图标256.png"
                                 Title="选择目标分组"
                                 ShowMinimizeButton="False"
                                 ShowMaximizeButton="False"/>

        <StackPanel Grid.Row="1" Margin="20">
            <TextBlock Text="请选择目标单位或部门：" Margin="0,0,0,10" FontSize="11pt"/>

            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4"
                    MaxHeight="300" MinHeight="150" Background="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TreeView x:Name="GroupTreeView"
                              SelectedItemChanged="GroupTreeView_SelectedItemChanged"
                              BorderThickness="0"
                              Background="Transparent">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True"/>
                                <Setter Property="Padding" Value="6,3,4,3"/>
                                <Setter Property="FontSize" Value="11pt"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>
            </Border>

            <!-- 提示 -->
            <TextBlock x:Name="HintTextBlock" Margin="0,10,0,0"
                       Foreground="Green" FontSize="10pt"
                       TextWrapping="Wrap" MinHeight="20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="确定" Style="{StaticResource DialogButtonStyle}" Click="OkButton_Click" IsDefault="True"/>
                <Button Content="取消" Style="{StaticResource DialogButtonStyle}" Click="CancelButton_Click" IsCancel="True" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
