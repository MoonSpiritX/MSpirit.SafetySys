<ui:FluentWindow x:Class="MS_SafetyManagementSystem.Views.ImportArchiveWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:MS_SafetyManagementSystem.Controls"
                 Title="导入存档"
                 Width="680" Height="480"
                 MinWidth="620" MinHeight="400"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResizeWithGrip"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="11pt"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="11pt"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <controls:WindowTitleBar Grid.Row="0"
                                 Icon="pack://application:,,,/Resources/斜月安全管理系统图标256.png"
                                 Title="导入存档"
                                 ShowMinimizeButton="False"
                                 ShowMaximizeButton="False"/>

        <!-- 包信息行 -->
        <Grid Grid.Row="1" Margin="15,10,15,0">
            <TextBlock x:Name="ArchiveInfoText" TextWrapping="Wrap" Foreground="#444444"/>
        </Grid>

        <!-- 项目清单 -->
        <DataGrid Grid.Row="2" Margin="15,8,15,0"
                  RowHeight="40"
                  ItemsSource="{Binding Rows, RelativeSource={RelativeSource AncestorType=Window}}"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  BorderBrush="#DDDDDD"
                  BorderThickness="1"
                  Background="Transparent"
                  Style="{StaticResource DataGridStyle}">

            <DataGrid.Columns>
                <!-- 勾选列 -->
                <DataGridTemplateColumn Width="50" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="导入" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 项目名称 -->
                <DataGridTextColumn Header="包内项目" Width="180" Binding="{Binding Name}" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="6,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 本地状态 -->
                <DataGridTextColumn Header="本地状态" Width="*" Binding="{Binding LocalStatusText}" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="6,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 处理策略 -->
                <DataGridTemplateColumn Header="处理方式" Width="130" CanUserSort="False">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding StrategyOptions}"
                                      SelectedItem="{Binding SelectedStrategy, Mode=TwoWay}"
                                      SelectionChanged="StrategyComboBox_SelectionChanged"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Width="110" Height="30"
                                      FontSize="10pt" Padding="8,3,8,2">
                                <!-- 显式指定字号（窗口级隐式 TextBlock 样式会覆盖继承值，需用本地值） -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="10pt"  Padding="8,2,8,2"  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部：进度 + 按钮 -->
        <Grid Grid.Row="3" Margin="15,10,15,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                <ProgressBar x:Name="ProgressBar" Height="8" IsIndeterminate="True" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText" Margin="0,4,0,0" Foreground="#666666" Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="开始导入" Width="100" Height="30" x:Name="StartImportButton"
                        Click="StartImport_Click" Style="{StaticResource SidePanelButtonStyle}"/>
                <Button Content="取消" Width="90" Height="30" Margin="8,0,0,0"
                        Click="Cancel_Click" Style="{StaticResource SidePanelButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
