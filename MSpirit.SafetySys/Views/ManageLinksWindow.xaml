<ui:FluentWindow x:Class="MS_SafetyManagementSystem.Views.ManageLinksWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:MS_SafetyManagementSystem.Controls"
                 xmlns:helpers="clr-namespace:MS_SafetyManagementSystem.Helpers"
                 Title="常用链接管理"
                 Width="850" Height="660"
                 MinWidth="850" MinHeight="660"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResizeWithGrip"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 helpers:WindowDragHelper.EnableDrag="True">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <!-- 全局字号 11pt -->
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="11pt"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="11pt"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="11pt"/>
        </Style>

        <!-- 分类按钮样式（基于全局 SidePanelButtonStyle，扩展高亮） -->
        <Style x:Key="CategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource SidePanelButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#CC5C89FF"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 全局标题栏 -->
        <controls:WindowTitleBar Grid.Row="0"
                                 Icon="pack://application:,,,/Resources/斜月安全管理系统图标256.png"
                                 Title="常用链接管理"
                                 ShowMinimizeButton="False"
                                 ShowMaximizeButton="False"/>

        <!-- 内容区域 -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧按钮区 -->
            <StackPanel Grid.Column="0" Width="140" Margin="0,0,15,0">
                <TextBox x:Name="SearchTextBox"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Tag="搜索网站或网址名"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="搜索当前分类下的网站名称或网址"/>
                <Separator Margin="0,5,0,5" Background="#CCCCCC"/>

                <!-- 分类切换组 -->
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}"
                                    CommandParameter="{Binding}"
                                    Click="CategoryButton_Click"
                                    Margin="0,3"
                                    Style="{StaticResource CategoryButtonStyle}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Separator Margin="0,5,0,5" Background="#CCCCCC"/>

                <!-- 操作组 -->
                <Button Content="打开网址" Command="{Binding OpenLinkCommand}" Style="{StaticResource SidePanelButtonStyle}"/>
                <Button Content="新建网址" Command="{Binding NewLinkCommand}" Style="{StaticResource SidePanelButtonStyle}"/>
                <Button Content="编辑网址" Command="{Binding EditLinkCommand}" Style="{StaticResource SidePanelButtonStyle}"/>
                <Button Content="删除网址" Command="{Binding DeleteLinkCommand}" Style="{StaticResource SidePanelButtonStyle}"/>
                <Separator Margin="0,5,0,5" Background="#CCCCCC"/>

                <!-- 排序组 -->
                <Button Content="置顶网址" Command="{Binding TopCommand}" Style="{StaticResource SidePanelButtonStyle}"/>
                <Button Content="上移网址" Command="{Binding UpCommand}" Style="{StaticResource SidePanelButtonStyle}"/>
                <Button Content="下移网址" Command="{Binding DownCommand}" Style="{StaticResource SidePanelButtonStyle}"/>
                <Button Content="移至最后" Command="{Binding BottomCommand}" Style="{StaticResource SidePanelButtonStyle}"/>
                <Separator Margin="0,5,0,5" Background="#CCCCCC"/>

                <!-- 关闭按钮 -->
                <Button Content="关闭" Command="{Binding CloseCommand}" Style="{StaticResource SidePanelButtonStyle}"/>
            </StackPanel>

            <!-- 右侧网址列表 + 底部提示行 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <!-- 数据表格 -->
                <DataGrid x:Name="LinksDataGrid"
                          Style="{StaticResource DataGridStyle}"
                          Grid.Row="0"
                          ItemsSource="{Binding FilteredLinks}"
                          SelectedItem="{Binding SelectedLink}"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          BorderBrush="#DDDDDD"
                          BorderThickness="1"
                          MouseDoubleClick="LinksDataGrid_MouseDoubleClick"
                          BeginningEdit="LinksDataGrid_BeginningEdit"
                          Background="Transparent">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Width="50" Binding="{Binding Order}" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="网站名称" Width="*" Binding="{Binding Name}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Left"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="ToolTip" Value="{Binding Description}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <StaticResource ResourceKey="DataGridEditTextBoxStyle"/>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="网址" Width="*" Binding="{Binding Url}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Left"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="ToolTip" Value="{Binding Url}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <StaticResource ResourceKey="DataGridEditTextBoxStyle"/>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 底部提示行 -->
                <Border Grid.Row="1"
                        BorderBrush="Transparent"
                        BorderThickness="0,1,0,0">
                    <TextBlock Text="{Binding FooterText, Mode=OneWay}"
                               FontSize="10pt"
                               FontFamily="Microsoft YaHei"
                               Foreground="Green"
                               TextWrapping="Wrap"
                               Margin="10,5,10,5"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>