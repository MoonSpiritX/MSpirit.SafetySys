<ui:FluentWindow x:Class="MS_SafetyManagementSystem.Views.DeleteProjectConfirmationWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:MS_SafetyManagementSystem.Controls"
                 Title="确认删除"
                 Width="450" SizeToContent="Height"
                 MinWidth="400" MinHeight="100"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0"
                                 Icon="pack://application:,,,/Resources/FoolMoon.png"
                                 Title="确认删除"
                                 ShowMinimizeButton="False"
                                 ShowMaximizeButton="False"/>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,10,0,20">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10">
                    确定要删除项目“<Run Text="{Binding ProjectName}"/>”吗？
                    <LineBreak/>
                    该操作不可恢复。
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确定" Style="{StaticResource DialogButtonStyle}" Command="{Binding ConfirmCommand}" IsDefault="True"/>
                <Button Content="取消" Style="{StaticResource DialogButtonStyle}" Command="{Binding CancelCommand}" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>