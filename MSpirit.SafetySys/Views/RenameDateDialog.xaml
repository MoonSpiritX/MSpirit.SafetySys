<ui:FluentWindow x:Class="MS_SafetyManagementSystem.Views.RenameDateDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:MS_SafetyManagementSystem.Controls"
                 Title="日期重命名"
                 Width="450" SizeToContent="Height"
                 MinWidth="400" MinHeight="100"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0"
                                 Icon="pack://application:,,,/Resources/斜月安全管理系统图标256.png"
                                 Title="日期重命名"
                                 ShowMinimizeButton="False"
                                 ShowMaximizeButton="False"/>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="当前日期" FontWeight="Bold" Margin="0,0,0,5"/>
                <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Background="#F5F5F5" Padding="8,5">
                    <TextBlock x:Name="CurrentDateText" FontSize="11pt"/>
                </Border>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="输入新日期（2位数字）" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="NewDateInput" Style="{StaticResource BaseTextBoxStyle}" MaxLength="2" TextChanged="OnTextChanged" ToolTip="格式：两位数字，例如 15 表示当月15日"/>

            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <TextBlock x:Name="PreviewLabel" FontSize="10pt">
                    <Run Text="新名称预览："/>
                    <Run x:Name="PreviewText" Text="" Foreground="Gray"/>
                </TextBlock>
                <TextBlock x:Name="WarningText" FontSize="10pt" Foreground="Orange" Margin="0,5,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button x:Name="OkButton" Content="确定" Style="{StaticResource DialogButtonStyle}" IsDefault="True" Click="OkButton_Click"/>
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource DialogButtonStyle}" IsCancel="True" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>