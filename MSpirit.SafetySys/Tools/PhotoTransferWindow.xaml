<ui:FluentWindow x:Class="MS_SafetyManagementSystem.Tools.PhotoTransferWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:MS_SafetyManagementSystem.Controls"
                 xmlns:helpers="clr-namespace:MS_SafetyManagementSystem.Helpers"
                 Title="手机图片传输"
                 Width="920" Height="600"
                 MinWidth="860" MinHeight="560"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 AllowDrop="True"
                 helpers:WindowDragHelper.EnableDrag="True">

    <ui:FluentWindow.Resources>
        <Style TargetType="TextBlock"> <Setter Property="FontSize" Value="11pt"/> </Style>

        <!-- 停止服务按钮（危险红）：与人员/隐患 LAN 窗口 DangerButtonStyle 同款色号 -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="11pt"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#EA4335" CornerRadius="8" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#c5221f"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#a50e0e"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="#ccc"/>
                                <Setter Property="Foreground" Value="#999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 位置列表项：悬停/选中淡蓝，与图片处理窗口左侧导航一致 -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="9,8" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MouseOverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>


    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0" Icon="pack://application:,,,/Resources/斜月安全管理系统图标256.png"
                                 Title="手机图片传输" ShowMinimizeButton="True" ShowMaximizeButton="True"/>

        <!-- 左右布局：左侧位置列表 / 右侧说明 + 文件列表 + 二维码 -->
        <Grid Grid.Row="1" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：保存位置列表 -->
            <Border Grid.Column="0" Background="Transparent" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <DockPanel Margin="10,10,10,20">
                    <!-- 标题区：保存位置文本（第一行）+ 添加自定义位置按钮（第二行），各自左对齐 -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                        <TextBlock Text="保存位置" FontSize="11pt" FontWeight="SemiBold" Foreground="#444"
                                   HorizontalAlignment="Left" Margin="0,0,0,10"/>
                        <!-- 按钮与下方位置列表背景区域等宽、左右对齐（Stretch 撑满） -->
                        <Button x:Name="AddLocationBtn" Content="添加自定义位置" Style="{StaticResource BaseButtonStyle}" Height="30"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Click="OnAddLocationClick"/>
                    </StackPanel>
                    <ListBox x:Name="LocationListBox" Background="Transparent" BorderThickness="0"
                             SelectionChanged="LocationListBox_SelectionChanged" FontSize="10.5pt"
                             PreviewMouseRightButtonDown="LocationListBox_PreviewMouseRightButtonDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- 默认位置显示"默认位置"，自定义位置显示末层文件夹名；悬停 ToolTip 显示完整路径 -->
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FullPath}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右侧 -->
            <Grid Grid.Column="1" Margin="15,10,15,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 说明 + 状态 -->
                <StackPanel Grid.Row="0">
                    <TextBlock TextWrapping="Wrap" FontSize="10.5pt" Foreground="#666" LineHeight="20">
                        手机扫码后可选择照片或拍照，图片将以原图传输到电脑当前选定的位置，
                        并按照片在手机中的拍摄（生成）时间自动归档到对应日期文件夹。
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Fill="Gray" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="服务未启动" FontSize="10.5pt" Foreground="#666"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="PortText" Text="" FontSize="10pt" Foreground="#888" Margin="18,4,0,0"/>
                </StackPanel>

                <!-- 内容区：左侧文件列表 / 右侧二维码 + 启动按钮 -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：传输文件列表（序号/拍摄时间/文件名/大小） -->
                    <Grid Grid.Column="0">
                        <DataGrid x:Name="FileListGrid" Style="{StaticResource DataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0"
                                  RowHeight="26" HeadersVisibility="Column"
                                  AlternationCount="2" FontSize="10pt"
                                  MouseDoubleClick="FileListGrid_MouseDoubleClick"
                                  PreviewMouseRightButtonDown="FileListGrid_PreviewMouseRightButtonDown"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridRow"><Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers><Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#F2F6FA"/></Trigger></Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="序号" Width="50" Binding="{Binding Index}" IsReadOnly="True">
                                    <!-- 序号列头居中（拍摄时间/文件名保持左对齐与数据一致） -->
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="拍摄时间" Width="140" Binding="{Binding ShootTimeText}" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="文件名" Width="*" MinWidth="120" Binding="{Binding FileName}" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding FileName}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="大小" Width="80" Binding="{Binding SizeText}" IsReadOnly="True">
                                    <!-- 大小列头居中（数据列保持右对齐） -->
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- 空态提示（有文件后隐藏） -->
                        <TextBlock x:Name="EmptyHint" Text="传输的图片将显示在此处"
                                   FontSize="10.5pt" Foreground="#AAA"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 右：二维码 + 启动/停止 -->
                    <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Padding="16,0,0,16">
                        <StackPanel>
                            <Image x:Name="QRCodeImage" Width="180" Height="180" Stretch="Uniform"
                                   Visibility="Collapsed" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="QRPlaceholder" Text="启动服务后生成二维码"
                                       Width="180" Height="180"
                                       FontSize="11pt" Foreground="#B4B2A9"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                            <!-- 启动/停止：双按钮重叠，按服务状态 Visibility 切换（不修改 Style，规避 WPF 限制） -->
                            <Grid Margin="0,14,0,0">
                                <Button x:Name="StartButton" Content="启动服务" Width="110" Height="32"
                                        Style="{StaticResource PrimaryButtonStyle}" FontWeight="SemiBold"
                                        Click="OnStartClick"/>
                                <Button x:Name="StopButton" Content="停止服务" Width="110" Height="32"
                                        Style="{StaticResource DangerButtonStyle}" FontWeight="SemiBold"
                                        Click="OnStopClick" Visibility="Collapsed"/>
                            </Grid>
                            <StackPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="已连接设备：" FontSize="11pt" Foreground="#666"/>
                                    <TextBlock x:Name="DeviceCountText" Text="0" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#17c3b2"/>
                                    <TextBlock Text=" 台" FontSize="10pt" Foreground="#999" VerticalAlignment="Bottom"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <TextBlock Text="已传输图片：" FontSize="11pt" Foreground="#666"/>
                                    <TextBlock x:Name="CountText" Text="0" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#17c3b2"/>
                                    <TextBlock Text=" 张" FontSize="10pt" Foreground="#999" VerticalAlignment="Bottom"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- 服务运行中提示（在"x张已接收"下方，与下方拖放提示互斥） -->
                            <TextBlock x:Name="RunningHint" Text="服务运行中，停止服务后可切换图片保存位置。"
                                       FontSize="9pt" Foreground="#B4B2A9" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed"/>
                            <!-- 服务关闭时拖放提示（在"x张已接收"下方，与上方运行中提示互斥） -->
                            <TextBlock x:Name="DragHint" Text="可拖动文件夹至此窗口任意位置，添加自定义保存位置"
                                       FontSize="9pt" Foreground="#B4B2A9" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <!-- 网络提示（与其他 LAN 窗口一致） -->
                            <TextBlock Text="扫码设备需与电脑连接至同一网络（仅限同一局域网设备访问）"
                                       FontSize="10pt" Foreground="#34A853"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"
                                       Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
