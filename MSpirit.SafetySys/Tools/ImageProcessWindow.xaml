<ui:FluentWindow x:Class="MS_SafetyManagementSystem.Tools.ImageProcessWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:MS_SafetyManagementSystem.Controls"
                 xmlns:helpers="clr-namespace:MS_SafetyManagementSystem.Helpers"
                 xmlns:tools="clr-namespace:MS_SafetyManagementSystem.Tools"
                 Title="图片处理"
                 Width="920" Height="600"
                 MinWidth="860" MinHeight="560"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 helpers:WindowDragHelper.EnableDrag="True">

    <ui:FluentWindow.Resources>
        <Style TargetType="TextBlock"> <Setter Property="FontSize" Value="11pt"/> </Style>

        <!-- 左侧导航项：透明圆角，悬停/选中淡蓝（与"关于软件"ListBox 选项视觉一致） -->
        <Style x:Key="NavBtn" TargetType="RadioButton">            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="11pt"/>
            <!-- 2026-08-16：原 DynamicResource TextFillColorPrimaryBrush 在 XAML 设计器无主题上下文时报
                 "无法解析资源"，改为明确颜色值（运行时行为一致，消除设计器警告） -->
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="9,10">
                            <ContentPresenter ContentSource="Content" VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MouseOverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 取消执行按钮（玫红警示） -->
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="11pt"/>
            <Setter Property="Background" Value="#E91E63"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#E91E63"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D81B60"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#C2185B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>


    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0" Icon="pack://application:,,,/Resources/斜月安全管理系统图标256.png"
                                 Title="图片处理" ShowMinimizeButton="True" ShowMaximizeButton="True"/>

        <!-- 左右布局：左侧导航 / 右侧内容（对齐"关于软件"规格） -->
        <Grid Grid.Row="1" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：导航（背景透明，透出窗口 Mica） -->
            <Border Grid.Column="0" Background="Transparent" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,10,0,0">
                    <RadioButton Content="方向转换" Style="{StaticResource NavBtn}"
                                 IsChecked="{Binding IsRotationVisible, Mode=OneWay}"
                                 Command="{Binding SelectModeCommand}" CommandParameter="rotation"/>
                    <RadioButton Content="标注与剪裁" Style="{StaticResource NavBtn}"
                                 IsChecked="{Binding IsCropVisible, Mode=OneWay}"
                                 Command="{Binding SelectModeCommand}" CommandParameter="crop"/>
                    <RadioButton Content="更多功能" Style="{StaticResource NavBtn}"
                                 IsChecked="{Binding IsMoreFeaturesVisible, Mode=OneWay}"
                                 Command="{Binding SelectModeCommand}" CommandParameter="more"/>
                </StackPanel>
            </Border>

            <!-- 右侧：内容区 -->
            <Grid Grid.Column="1" Margin="16,10,16,14">

                <!-- ══════════════════════════════════ -->
                <!--  方向转换面板                        -->
                <!-- ══════════════════════════════════ -->
                <Grid Visibility="{Binding IsRotationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 工具栏：文件操作（伪菜单栏，固定顶部；其他面板共用此骨架） -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="添加文件" Style="{StaticResource BaseButtonStyle}" Width="100" Height="30"
                                Command="{Binding RotateAddFilesCommand}" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="添加文件夹" Style="{StaticResource BaseButtonStyle}" Width="100" Height="30"
                                Command="{Binding RotateAddFolderCommand}" Margin="0,0,10,0"/>
                        <Button Grid.Column="2" Content="移除选中" Style="{StaticResource BaseButtonStyle}" Width="100" Height="30"
                                Command="{Binding RotateRemoveSelectedCommand}" Margin="0,0,10,0"/>
                        <Button Grid.Column="3" Content="清空列表" Style="{StaticResource BaseButtonStyle}" Width="100" Height="30"
                                Command="{Binding RotateClearCommand}"/>
                        <TextBlock Grid.Column="5" Text="{Binding RotateFileCountText}" FontSize="10pt" FontWeight="SemiBold"
                                   Foreground="#0f8f82" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 文件列表 -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <DataGrid ItemsSource="{Binding RotateFiles}"
                                  SelectedItem="{Binding SelectedRotateFile}"
                                  SelectionChanged="RotateDataGrid_SelectionChanged"
                                  Style="{StaticResource DataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0"
                                  RowHeight="26" HeadersVisibility="Column"
                                  AlternationCount="2" FontSize="10pt"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridRow"><Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers><Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#F2F6FA"/></Trigger></Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <!-- 序号列：固定宽 + 居中（Stretch 撑满单元格使 TextAlignment 生效） -->
                                <DataGridTextColumn Header="序号" Width="60" MinWidth="50" Binding="{Binding Index}" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="文件名" Width="*" MinWidth="120" Binding="{Binding FileName}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- 路径列固定宽 + 省略号 + ToolTip 查看完整目录 -->
                                <DataGridTextColumn Header="路径" Width="200" MinWidth="120" Binding="{Binding DirectoryPath}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding DirectoryPath}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="格式" Width="80" MinWidth="60" Binding="{Binding Extension}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="状态" Width="80" MinWidth="60" Binding="{Binding Status}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 空列表水印提示：仅列表无图片时显示（Count==0），有图片后自动隐藏；
                             IsHitTestVisible=False 保证不拦截拖放事件 -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RotateFiles.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- 图片占位图标（Path 绘制，无字体字符依赖） -->
                            <Grid Width="44" Height="44" Margin="0,0,0,12">
                                <Rectangle Stroke="#B8B8B8" StrokeThickness="1.5" RadiusX="7" RadiusY="7" Fill="Transparent"/>
                                <Path Data="M12,29 L19,20 L24,26 L28,21 L36,30"
                                      Stroke="#B8B8B8" StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent"/>
                                <Ellipse Width="7" Height="7" Stroke="#B8B8B8" StrokeThickness="1.5" Fill="Transparent"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,9,0"/>
                            </Grid>

                            <TextBlock Text="点击上方按钮添加图片，或将图片拖入此处"
                                       FontSize="11pt" Foreground="#999999" HorizontalAlignment="Center"/>
                            <TextBlock Text="支持 PNG / JPG / JPEG / BMP / WEBP / TIFF / GIF"
                                       FontSize="9pt" Foreground="#B0B0B0" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 操作方式：静态标签 + 下拉菜单（下拉框内显示具体操作文本） -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="操作方式" FontSize="10pt" Foreground="#666666" VerticalAlignment="Center"/>
                        <!-- Height/MinHeight 与 30 高的按钮对齐（防止 WPF-UI 隐式样式的默认高度撑开）；边框与全局按钮一致 #B0B0B0。
                             Padding 上下压缩到 2px：给内容区让出高度，避免文字底部被裁剪（模板默认上下留白约 6px，内容区仅剩约 16px） -->
                        <ComboBox ItemsSource="{Binding RotationOptions}"
                                  SelectedItem="{Binding SelectedRotationOption}"
                                  Width="100" Height="30" MinHeight="30" FontSize="10pt"
                                  BorderBrush="#B0B0B0" BorderThickness="1"
                                  Padding="10,2,0,2"
                                  VerticalContentAlignment="Center" Margin="10,0,0,0"
                                  IsEnabled="{Binding IsNotProcessing}"/>
                    </StackPanel>

                    <!-- 面板状态栏（选项级，高度 30）：显示当前面板操作状态 -->
                    <Border Grid.Row="3" Background="Transparent" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                        <TextBlock Text="{Binding StatusText}" FontSize="10pt" Foreground="#666" VerticalAlignment="Center"/>
                    </Border>

                    <!-- 底部操作栏：进度条 + 开始/取消执行（页面最后一行） -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Maximum=1 与 ViewModel 的 ProgressValue（0~1 小数）量纲对齐，否则进度条按 0~100 渲染只有 1% -->
                        <ProgressBar Grid.Column="0" Value="{Binding ProgressValue}" Maximum="1" Height="6"
                                     VerticalAlignment="Center" Margin="0,0,14,0"
                                     Background="#E8E8E8" Foreground="#17c3b2"/>
                        <!-- 开始执行 / 取消执行：双按钮重叠，按 IsProcessing 显隐切换（不修改 Style 属性，规避 WPF 限制） -->
                        <Grid Grid.Column="1">
                            <Button Content="开始执行" Command="{Binding ExecuteRotationCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Width="128" Height="30"
                                    FontWeight="SemiBold"
                                    Visibility="{Binding IsNotProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="取消执行" Command="{Binding CancelRotationCommand}"
                                    Style="{StaticResource CancelButtonStyle}" Width="128" Height="30"
                                    FontWeight="SemiBold"
                                    Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ══════════════════════════════════ -->
                <!--  标注与剪裁面板                        -->
                <!-- ══════════════════════════════════ -->
                <!-- 外层：显隐绑主 VM；内层：DataContext 切裁剪 VM（分层避免 Visibility 绑定被 DataContext 架空） -->
                <Grid Visibility="{Binding IsCropVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid DataContext="{Binding CropViewModel}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 工具栏：文件操作（与方向转换同骨架） -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="添加文件" Style="{StaticResource BaseButtonStyle}" Width="100" Height="30"
                                Command="{Binding AddFilesCommand}" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="添加文件夹" Style="{StaticResource BaseButtonStyle}" Width="100" Height="30"
                                Command="{Binding AddFolderCommand}" Margin="0,0,10,0"/>
                        <Button Grid.Column="2" Content="清空预览" Style="{StaticResource BaseButtonStyle}" Width="100" Height="30"
                                Command="{Binding ClearPreviewCommand}" Margin="0,0,10,0"/>
                        <Button Grid.Column="3" Content="清空列表" Style="{StaticResource BaseButtonStyle}" Width="100" Height="30"
                                Command="{Binding ClearCommand}"/>
                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PositionText}" FontSize="10pt" FontWeight="SemiBold"
                                       Foreground="#0f8f82" VerticalAlignment="Center"/>
                            <!-- 输出方式（2026-08-16 从底部移入）：文本样式与"第 x/x 张"一致，间距 10 -->
                            <TextBlock Text="输出方式" FontSize="10pt" FontWeight="SemiBold"
                                       Foreground="#0f8f82" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <ComboBox ItemsSource="{Binding OutputModeOptions}"
                                      SelectedIndex="{Binding SelectedOutputModeIndex}"
                                      Width="120" Height="30" MinHeight="30" FontSize="10pt"
                                      BorderBrush="#B0B0B0" BorderThickness="1"
                                      Padding="8,2,0,2" VerticalContentAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 两列：左分组图片列表 / 右预览编辑区 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左：分组列表（按文件夹分组，单选） -->
                        <Border Grid.Column="0" Background="Transparent" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Margin="0,0,12,10">
                            <TreeView ItemsSource="{Binding Groups}"
                                      SelectedItemChanged="CropTreeView_SelectedItemChanged"
                                      PreviewMouseLeftButtonDown="CropTreeView_PreviewMouseLeftButtonDown"
                                      BorderThickness="0" Background="Transparent"
                                      FontSize="10.5pt" Margin="0,0,6,0">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                        <Setter Property="Padding" Value="2,3"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.Resources>
                                    <!-- 分组（文件夹）节点：末端文件夹名 -->
                                    <HierarchicalDataTemplate DataType="{x:Type tools:CropGroupItem}" ItemsSource="{Binding Files}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📁 " FontSize="10pt"/>
                                            <TextBlock Text="{Binding FolderName}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                    <!-- 图片子项：文件名 -->
                                    <DataTemplate DataType="{x:Type tools:CropFileItem}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FileName}" ToolTip="{Binding FilePath}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </Border>

                        <!-- 右：预览编辑区（裁剪交互） -->
                        <Border Grid.Column="1" Background="Transparent" BorderBrush="#E0E0E0" BorderThickness="1"
                                CornerRadius="6" Margin="0,0,0,10" Padding="4">
                            <tools:CropOverlay x:Name="CropOverlayControl"
                                               AspectRatio="{Binding CropAspectRatio, Mode=OneWay}"/>
                        </Border>
                    </Grid>

                    <!-- 标注工具行 + 状态栏（2026-08-16 阶段 5）：左=标注工具，右=选区信息 -->
                    <Grid Grid.Row="2" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 标注颜色（2026-08-16）：选色后标注工具绘制该颜色；尺寸对齐裁剪比例下拉；
                                 下拉项 = 小圆角色块 + 颜色名（色块经 AnnotationColorBrushes 一一对应） -->
                            <TextBlock Text="标注颜色" FontSize="10pt" Foreground="#666666" VerticalAlignment="Center"/>
                            <ComboBox x:Name="AnnotationColorCombo" ItemsSource="{Binding AnnotationColorOptions}"
                                      SelectedIndex="{Binding SelectedAnnotationColorIndex}"
                                      Width="90" Height="30" MinHeight="30" FontSize="10pt"
                                      BorderBrush="#B0B0B0" BorderThickness="1"
                                      Padding="8,2,0,2" VerticalContentAlignment="Center" Margin="10,0,8,0"
                                      DropDownOpened="AnnotationCombo_DropDownOpened">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="14" Height="14" CornerRadius="3"
                                                    Background="{Binding Brush}"
                                                    BorderBrush="#888888" BorderThickness="0.5" Margin="0,0,6,0"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <!-- 字号（2026-08-16）：文字工具的字号（像素）；线宽：矩形/圆/线/箭头线宽 -->
                            <TextBlock Text="字号" FontSize="10pt" Foreground="#666666" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <ComboBox x:Name="AnnotationFontSizeCombo" ItemsSource="{Binding AnnotationFontSizeOptions}"
                                      SelectedIndex="{Binding SelectedFontSizeIndex}"
                                      Width="70" Height="30" MinHeight="30" FontSize="10pt"
                                      BorderBrush="#B0B0B0" BorderThickness="1"
                                      Padding="4,2,0,2" VerticalContentAlignment="Center" Margin="6,0,0,0"
                                      DropDownOpened="AnnotationCombo_DropDownOpened"/>
                            <TextBlock Text="线宽" FontSize="10pt" Foreground="#666666" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <ComboBox x:Name="AnnotationLineWidthCombo" ItemsSource="{Binding AnnotationLineWidthOptions}"
                                      SelectedIndex="{Binding SelectedLineWidthIndex}"
                                      Width="70" Height="30" MinHeight="30" FontSize="10pt"
                                      BorderBrush="#B0B0B0" BorderThickness="1"
                                      Padding="4,2,0,2" VerticalContentAlignment="Center" Margin="6,0,0,0"
                                      DropDownOpened="AnnotationCombo_DropDownOpened"/>
                            <TextBlock Text="标注工具" FontSize="10pt" Margin="10,0,0,0" Foreground="#666666" VerticalAlignment="Center"/>
                            <Button x:Name="AnnotRectButton" Width="30" Height="30" Margin="8,0,2,0" BorderThickness="0" Background="Transparent"
                                    ToolTip="矩形" Tag="{x:Static tools:AnnotationKind.Rectangle}" Click="AnnotTool_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#E8F0FE"/>
                                                        </Trigger>
                                                        
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Path Data="M3,3 L21,3 L21,21 L3,21 Z" Stroke="#444444" StrokeThickness="2"/>
                            </Button>
                            <Button x:Name="AnnotOvalButton" Width="30" Height="30" Margin="2,0,2,0"
                                    ToolTip="圆形" Tag="{x:Static tools:AnnotationKind.Oval}" Click="AnnotTool_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#E8F0FE"/>
                                                        </Trigger>
                                                        
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Path Stroke="#444444" StrokeThickness="2">
                                    <Path.Data>
                                        <EllipseGeometry Center="12,12" RadiusX="9" RadiusY="9"/>
                                    </Path.Data>
                                </Path>
                            </Button>
                            <Button x:Name="AnnotLineButton" Width="30" Height="30" Margin="2,0,2,0"
                                    ToolTip="直线" Tag="{x:Static tools:AnnotationKind.Line}" Click="AnnotTool_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#E8F0FE"/>
                                                        </Trigger>
                                                        
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Line X1="3" Y1="21" X2="21" Y2="3" Stroke="#444444" StrokeThickness="2"/>
                            </Button>
                            <Button x:Name="AnnotArrowButton" Width="30" Height="30" Margin="2,0,2,0"
                                    ToolTip="箭头" Tag="{x:Static tools:AnnotationKind.Arrow}" Click="AnnotTool_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#E8F0FE"/>
                                                        </Trigger>
                                                        
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Path Data="M3,21 L17,7 M17,7 L9,7 M17,7 L17,15" Stroke="#444444" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button>
                            <Button x:Name="AnnotTextButton" Width="30" Height="30" Margin="2,0,2,0"
                                    ToolTip="文字" Tag="{x:Static tools:AnnotationKind.Text}" Click="AnnotTool_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#E8F0FE"/>
                                                        </Trigger>
                                                        
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="文" FontSize="14" FontWeight="SemiBold" Foreground="#444444"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="AnnotMosaicButton" Width="30" Height="30" Margin="2,0,0,0"
                                    ToolTip="马赛克" Tag="{x:Static tools:AnnotationKind.Mosaic}" Click="AnnotTool_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#E8F0FE"/>
                                                        </Trigger>
                                                        
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <!-- 马赛克块：黑白小色块 2×2 拼接（固定尺寸，2026-08-16） -->
                                <Grid Width="20" Height="20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Row="0" Grid.Column="0" Fill="#8A000000" Margin="0.5"/>
                                    <Rectangle Grid.Row="0" Grid.Column="1" Fill="#FFFFFF" Margin="0.5"/>
                                    <Rectangle Grid.Row="1" Grid.Column="0" Fill="#FFFFFF" Margin="0.5"/>
                                    <Rectangle Grid.Row="1" Grid.Column="1" Fill="#8A000000" Margin="0.5"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 底部操作行：裁剪比例 + 输出方式 + 操作按钮 -->
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="裁剪比例" FontSize="10pt" Foreground="#666666" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding CropAspectOptions}"
                                      SelectedIndex="{Binding SelectedCropAspectIndex}"
                                      Width="90" Height="30" MinHeight="30" FontSize="10pt"
                                      BorderBrush="#B0B0B0" BorderThickness="1"
                                      Padding="8,2,0,2" VerticalContentAlignment="Center" Margin="10,0,8,0"/>
                            <!-- 选区信息（2026-08-16 从标注行移入）：表示裁剪，跟在裁剪比例下拉后，间距 10。
                                 内容以半角数字/字母为主（如 1200×800px），同等字号视觉小于中文全角字，
                                 故加粗（SemiBold）补偿，与"第 x/x 张"风格一致 -->
                            <TextBlock Text="{Binding StatusText}" FontSize="10pt" FontWeight="SemiBold" Foreground="#666666"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="应用" Style="{StaticResource PrimaryButtonStyle}" Width="110" Height="30"
                                    FontWeight="SemiBold" Margin="10,0,0,0"
                                    Command="{Binding ApplyCropCommand}"/>
                            <Button Content="应用并下一张" Style="{StaticResource BaseButtonStyle}" Width="120" Height="30"
                                    Margin="8,0,0,0"
                                    Command="{Binding ApplyAndNextCommand}"/>
                        </StackPanel>
                    </Grid>
                    </Grid>
                </Grid>

                <!-- ═══ 更多功能（规划中）介绍 ═══ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsMoreFeaturesVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="4,6,8,4">
                        <TextBlock Text="更多功能（规划中）" FontSize="14pt" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="以下功能正在规划或开发中，将在后续版本陆续上线，敬请期待："
                                   FontSize="10.5pt" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- 功能条目：格式及压缩 -->
                        <Border Background="#F7F9FB" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="格式及压缩" FontSize="11.5pt" FontWeight="SemiBold"/>
                                    <TextBlock Text="批量转换图片格式与压缩体积（JPEG 质量、尺寸缩放、批量输出）"
                                               FontSize="10pt" Foreground="#666666" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#FFF4E5" CornerRadius="4" Padding="8,3" VerticalAlignment="Top">
                                    <TextBlock Text="规划中" FontSize="9pt" Foreground="#C77700"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 功能条目：EXIF / OCR -->
                        <Border Background="#F7F9FB" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="EXIF / OCR" FontSize="11.5pt" FontWeight="SemiBold"/>
                                    <TextBlock Text="查看照片拍摄信息（EXIF），图片文字识别（复用内置 PaddleOCR）"
                                               FontSize="10pt" Foreground="#666666" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#FFF4E5" CornerRadius="4" Padding="8,3" VerticalAlignment="Top">
                                    <TextBlock Text="规划中" FontSize="9pt" Foreground="#C77700"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 功能条目：证件照生成 -->
                        <Border Background="#F7F9FB" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="证件照生成" FontSize="11.5pt" FontWeight="SemiBold"/>
                                    <TextBlock Text="从普通照片一键生成标准证件照（尺寸规格、背景色处理）"
                                               FontSize="10pt" Foreground="#666666" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#FFF4E5" CornerRadius="4" Padding="8,3" VerticalAlignment="Top">
                                    <TextBlock Text="规划中" FontSize="9pt" Foreground="#C77700"/>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Text="你有想实现的功能？欢迎反馈建议，我们会评估排期。"
                                   FontSize="9.5pt" Foreground="#999999" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
